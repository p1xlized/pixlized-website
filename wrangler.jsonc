{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixlized-website",
  "compatibility_date": "2024-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/_worker.js",
  "assets": {
    "directory": "./dist",
    "exclude": ["_worker.js", "_worker.js/**"],
  },
  "env": {
    "production": {
      "name": "pixlized-website",
      "compatibility_date": "2024-09-25",
      "compatibility_flags": ["nodejs_compat"],
      "main": "./dist/_worker.js",
      "assets": {
        "directory": "./dist",
        "exclude": ["_worker.js", "_worker.js/**"],
      },
    },
  },
}
