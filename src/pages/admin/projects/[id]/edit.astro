---
import MainLayout from "@/layouts/main.astro"
import { getProjects, getD1 } from "@/db/db"

// Get D1 instance from Cloudflare runtime locals
const d1 = getD1()

const { id } = Astro.params

// Get all projects
const projects = await getProjects(d1)
const project = projects.find((p) => p.id === Number(id))

if (!project) {
  return Response.redirect(new URL("/admin/projects", Astro.request.url), 302)
}

// Get all unique tags for dropdown
const tagOptions = [...new Set(projects.map((p) => p.tag).filter(Boolean))]
---

<MainLayout>
  <section
    class="flex h-full w-full flex-col items-center justify-start px-4 py-12"
  >
    <div class="w-full max-w-2xl space-y-6">
      <!-- Header -->
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold tracking-tight">
            <span class="font-mono text-[hsl(var(--chart-1))]">✏️</span> Edit Project
          </h1>
          <p class="mt-1 text-sm text-muted-foreground">
            Edit "{project.title}"
          </p>
        </div>
        <a
          href="/admin/projects"
          class="rounded-sm border border-border bg-secondary/50 px-3 py-1.5 font-mono text-xs font-bold tracking-wider uppercase transition-colors hover:bg-secondary/80"
        >
          Back
        </a>
      </div>

      <!-- Form -->
      <form
        id="edit-project-form"
        class="space-y-6 rounded-sm border border-border bg-card p-6 shadow-sm"
      >
        <input type="hidden" id="project-id" value={project.id} />

        <!-- Title -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Title *
          </label>
          <input
            type="text"
            id="project-title"
            name="title"
            value={project.title}
            required
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
        </div>

        <!-- Tech Stack -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Tech Stack
          </label>
          <input
            type="text"
            id="project-tech"
            name="tech"
            value={project.tech || ""}
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
        </div>

        <!-- Role -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Role
          </label>
          <input
            type="text"
            id="project-role"
            name="role"
            value={project.role || ""}
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
        </div>

        <!-- Date -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Date
          </label>
          <input
            type="text"
            id="project-date"
            name="date"
            value={project.date || ""}
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
        </div>

        <!-- Released At -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Release Date (YYYY-MM-DD)
          </label>
          <input
            type="date"
            id="project-releasedAt"
            name="releasedAt"
            value={project.releasedAt || ""}
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
        </div>

        <!-- Tag -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Tag
          </label>
          <select
            id="project-tag"
            name="tag"
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          >
            <option value="">Select a tag...</option>
            {
              tagOptions.map((tag) => (
                <option key={tag} value={tag} selected={project.tag === tag}>
                  {tag}
                </option>
              ))
            }
            <option value="MOBILE" selected={project.tag === "MOBILE"}
              >MOBILE</option
            >
            <option value="WEB" selected={project.tag === "WEB"}>WEB</option>
            <option value="GAME" selected={project.tag === "GAME"}>GAME</option>
          </select>
        </div>

        <!-- Description -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Description
          </label>
          <textarea
            id="project-description"
            name="description"
            rows={4}
            class="w-full resize-none rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
            >{project.description || ""}</textarea
          >
        </div>

        <!-- Cover Image URL -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Cover Image URL
          </label>
          <input
            type="text"
            id="project-cover"
            name="cover"
            value={project.cover || ""}
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
        </div>

        <!-- Images (comma-separated) -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Images (comma-separated URLs)
          </label>
          <input
            type="text"
            id="project-imgs"
            name="imgs"
            value={imgs.join(", ")}
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
          <p class="font-mono text-[10px] text-muted-foreground/60">
            Enter image URLs separated by commas
          </p>
        </div>

        <!-- GitHub URL -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            GitHub URL
          </label>
          <input
            type="url"
            id="project-githubUrl"
            name="githubUrl"
            value={project.githubUrl || ""}
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
        </div>

        <!-- Project URL -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Live URL
          </label>
          <input
            type="url"
            id="project-projectUrl"
            name="projectUrl"
            value={project.projectUrl || ""}
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
        </div>

        <!-- Features (comma-separated) -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Features (comma-separated)
          </label>
          <input
            type="text"
            id="project-features"
            name="features"
            value={features.join(", ")}
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
        </div>

        <!-- Stack (comma-separated) -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Stack (comma-separated)
          </label>
          <input
            type="text"
            id="project-stack"
            name="stack"
            value={stack.join(", ")}
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
        </div>

        <!-- Awards (JSON) -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Awards (JSON format)
          </label>
          <textarea
            id="project-awards"
            name="awards"
            rows={3}
            class="w-full resize-none rounded-sm border border-border bg-secondary/40 px-3 py-2.5 font-mono text-sm text-[10px] transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
            >{JSON.stringify(awards, null, 2)}</textarea
          >
        </div>

        <!-- Metrics (JSON) -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Metrics (JSON format)
          </label>
          <textarea
            id="project-metrics"
            name="metrics"
            rows={3}
            class="w-full resize-none rounded-sm border border-border bg-secondary/40 px-3 py-2.5 font-mono text-sm text-[10px] transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
            >{JSON.stringify(metrics, null, 2)}</textarea
          >
        </div>

        <!-- Featured & Personal -->
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-1">
            <label
              class="flex items-center gap-2 font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
            >
              <input
                type="checkbox"
                id="project-isFeatured"
                name="isFeatured"
                value="1"
                {project.isFeatured === 1 ? 'checked' : ''}
                class="h-3 w-3"
              />
              Featured
            </label>
          </div>
          <div class="space-y-1">
            <label
              class="flex items-center gap-2 font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
            >
              <input
                type="checkbox"
                id="project-isPersonal"
                name="isPersonal"
                value="1"
                {project.isPersonal === 1 ? 'checked' : ''}
                class="h-3 w-3"
              />
              Personal
            </label>
          </div>
        </div>

        <!-- Submit -->
        <div class="flex gap-2">
          <button
            type="submit"
            class="flex-1 rounded-sm bg-[hsl(var(--chart-1))] py-2.5 font-mono text-sm font-bold tracking-wider text-white uppercase transition-all hover:bg-[hsl(var(--chart-1))]/90"
          >
            Update Project
          </button>
          <button
            type="button"
            onclick="window.location.href='/admin/projects'"
            class="rounded-sm border border-border bg-secondary/50 px-4 py-2.5 font-mono text-sm font-bold tracking-wider uppercase transition-colors hover:bg-secondary/80"
          >
            Cancel
          </button>
          <button
            type="button"
            id="delete-project"
            class="rounded-sm border border-red-500 bg-red-500/10 px-4 py-2.5 font-mono text-sm font-bold tracking-wider text-red-500 uppercase transition-all hover:bg-red-500/20"
          >
            Delete
          </button>
        </div>
      </form>
    </div>
  </section>

  <script>
    // Check auth on page load
    document.addEventListener("DOMContentLoaded", () => {
      const isLoggedIn =
        sessionStorage.getItem("admin_logged_in") ||
        localStorage.getItem("admin_token")
      if (!isLoggedIn) {
        const adminSeed = import.meta.env.ADMIN_SEED
        window.location.href = `/secret/${adminSeed}/admin`
      }

      // Form submission
      const form = document.getElementById("edit-project-form")
      const deleteBtn = document.getElementById("delete-project")
      const projectId = (
        document.getElementById("project-id") as HTMLInputElement
      ).value

      form?.addEventListener("submit", async (e) => {
        e.preventDefault()

        const formData = {
          id: projectId,
          title: (document.getElementById("project-title") as HTMLInputElement)
            .value,
          tech: (document.getElementById("project-tech") as HTMLInputElement)
            .value,
          role: (document.getElementById("project-role") as HTMLInputElement)
            .value,
          date: (document.getElementById("project-date") as HTMLInputElement)
            .value,
          releasedAt: (
            document.getElementById("project-releasedAt") as HTMLInputElement
          ).value,
          tag: (document.getElementById("project-tag") as HTMLInputElement)
            .value,
          description: (
            document.getElementById(
              "project-description"
            ) as HTMLTextAreaElement
          ).value,
          cover: (document.getElementById("project-cover") as HTMLInputElement)
            .value,
          imgs: (document.getElementById("project-imgs") as HTMLInputElement)
            .value,
          githubUrl: (
            document.getElementById("project-githubUrl") as HTMLInputElement
          ).value,
          projectUrl: (
            document.getElementById("project-projectUrl") as HTMLInputElement
          ).value,
          features: (
            document.getElementById("project-features") as HTMLInputElement
          ).value,
          stack: (document.getElementById("project-stack") as HTMLInputElement)
            .value,
          awards: (
            document.getElementById("project-awards") as HTMLTextAreaElement
          ).value,
          metrics: (
            document.getElementById("project-metrics") as HTMLTextAreaElement
          ).value,
          isFeatured: (
            document.getElementById("project-isFeatured") as HTMLInputElement
          ).checked
            ? 1
            : 0,
          isPersonal: (
            document.getElementById("project-isPersonal") as HTMLInputElement
          ).checked
            ? 1
            : 0,
        }

        try {
          const response = await fetch("/api/admin/projects", {
            method: "PUT",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${localStorage.getItem("admin_token")}`,
            },
            body: JSON.stringify(formData),
          })

          if (response.ok) {
            window.location.href = "/admin/projects"
          } else {
            const error = await response.json()
            alert(error.error || "Failed to update project")
          }
        } catch (err) {
          alert("Error updating project: " + err)
        }
      })

      // Delete button
      deleteBtn?.addEventListener("click", async () => {
        if (
          !confirm(
            "Are you sure you want to delete this project? This cannot be undone."
          )
        ) {
          return
        }

        try {
          const response = await fetch("/api/admin/projects", {
            method: "DELETE",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${localStorage.getItem("admin_token")}`,
            },
            body: JSON.stringify({ id: projectId }),
          })

          if (response.ok) {
            window.location.href = "/admin/projects"
          } else {
            const error = await response.json()
            alert(error.error || "Failed to delete project")
          }
        } catch (err) {
          alert("Error deleting project: " + err)
        }
      })
    })
  </script>
</MainLayout>
