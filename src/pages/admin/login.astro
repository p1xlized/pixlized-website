---
import Layout from "../../layouts/main.astro"
import "@/styles/global.css"

let errorMessage = ""

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData()
  const password = formData.get("password")?.toString()
  const expectedPassword = import.meta.env.ADMIN_PASSWORD

  if (password === expectedPassword) {
    Astro.cookies.set("admin_session", password as String, {
      path: "/",
      httpOnly: true,
      secure: true,
      maxAge: 60 * 60 * 24 * 7,
    })
    return Astro.redirect("/admin")
  } else {
    errorMessage = "Invalid admin password."
  }
}
---

<Layout title="Admin Login">
  <main
    class="mx-auto flex min-h-screen max-w-md items-center justify-center bg-background px-6 py-24 text-foreground"
  >
    <div class="w-full space-y-6 rounded-xl border border-muted bg-card/60 p-6">
      <div>
        <h1 class="text-2xl font-bold">Admin Gate</h1>
        <p class="mt-1 text-sm text-foreground/80">
          Identify yourself to access the dashboard.
        </p>
      </div>

      {
        errorMessage && (
          <div class="rounded border border-destructive bg-red-500/10 p-3 text-sm text-chart-5">
            {errorMessage}
          </div>
        )
      }

      <form method="POST" class="space-y-4">
        <div>
          <label class="mb-1 block text-sm font-medium text-foreground"
            >Password</label
          >
          <input
            type="password"
            name="password"
            required
            class="w-full rounded-md border border-muted bg-background/80 p-2 text-white focus:border-white focus:outline-none"
          />
        </div>
        <button
          type="submit"
          class="w-full rounded-md bg-white py-2 font-medium text-black transition-colors hover:bg-neutral-200"
          >Login</button
        >
      </form>
    </div>
  </main>
</Layout>
