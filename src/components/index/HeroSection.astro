---
// HeroSection.astro - First section with profile, latest blog posts, YT video, action buttons, and dialogs
import { getCollection } from "astro:content"
import { memoizedQuery } from "@/utils/memoize"

// Memoized query for latest 3 blog posts from content collection
const getRecentBlogPosts = async () => {
  try {
    const posts = (await getCollection("blog")).sort(
      (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
    )
    return posts.slice(0, 3).map((post) => ({
      title: post.data.title,
      date: new Date(post.data.pubDate).toLocaleDateString("en-US", {
        year: "numeric",
        month: "short",
        day: "numeric",
      }),
      link: `/blog/${post.id}`,
    }))
  } catch (error) {
    // Fallback if content collection fails
    return []
  }
}

// Memoize the query - will only run once per deployment
const recentBlogPosts = await memoizedQuery(
  "hero_recent_blog_posts",
  getRecentBlogPosts
)

// Fallback blog posts if content collection is empty
const fallbackBlogPosts = [
  {
    title: "Building an Ultra-Fast Portfolio with Astro",
    date: "July 15, 2026",
    link: "/blog/astro-portfolio",
  },
  {
    title: "The Subtle Art of Dark Mode Empathy",
    date: "June 28, 2026",
    link: "/blog/dark-mode-empathy",
  },
  {
    title: "Designing Snapping Full-Height Layouts",
    date: "May 14, 2026",
    link: "/blog/snapping-layouts",
  },
]

const posts = recentBlogPosts.length > 0 ? recentBlogPosts : fallbackBlogPosts

// Social links for LinkTree dialog
const socialLinks = [
  { name: "GitHub", url: "https://github.com/pixlized" },
  { name: "LinkedIn", url: "https://linkedin.com/in/pixlized" },
  { name: "Twitter/X", url: "https://twitter.com/pixlized" },
  { name: "Email", url: "mailto:contact@pixlized.dev" },
  { name: "YouTube", url: "https://youtube.com/@pixlized" },
  { name: "Discord", url: "https://discord.gg/pixlized" },
]

// Get platform icon SVG paths
function getIconPath(platform: string) {
  const icons = {
    github:
      "M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22",
    linkedin:
      "M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z",
    twitter:
      "M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z",
    mail: "M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z",
    youtube:
      "M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-7.5-8.25z",
    discord:
      "M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z",
  }
  return (
    icons[platform as keyof typeof icons] || "M12 2v20M12 20L5 15M12 20L19 15"
  )
}
---

<section
  data-label="Overview"
  id="overview"
  class="flex h-full w-full shrink-0 snap-start flex-col items-center justify-between py-6"
>
  <div></div>

  <div class="flex w-full max-w-4xl flex-col items-center space-y-8 px-4">
    <!-- Profile Header with New Image Style -->
    <div
      class="flex w-full flex-col items-center gap-4 border-b border-border/40 pb-6"
    >
      <!-- New Hero Image with Glow Effect -->
      <div class="group relative">
        <div
          class="absolute inset-0 rounded-xl bg-gradient-to-br from-primary/10 via-transparent to-transparent opacity-60 blur-2xl"
        >
        </div>
        <img
          src="/avatar.webp"
          alt="@pixlized profile image"
          class="relative h-28 w-28 shrink-0 rounded-xl border-2 border-primary/30 bg-muted object-cover shadow-2xl shadow-primary/10 transition-all duration-300 group-hover:scale-105 group-hover:border-primary/50 group-hover:shadow-primary/20 sm:h-32 sm:w-32"
        />
        <div
          class="absolute -right-2 -bottom-2 flex h-7 w-7 items-center justify-center rounded-full border-2 border-background bg-primary/20 backdrop-blur-sm"
        >
          <span class="text-[11px] font-bold text-primary">⚡</span>
        </div>
        <!-- Decorative particles -->
        <div
          class="absolute -top-4 -left-4 h-3 w-3 rounded-full bg-primary/20 blur-xl"
        >
        </div>
        <div
          class="absolute -right-6 -bottom-6 h-4 w-4 rounded-full bg-primary/15 blur-xl"
        >
        </div>
      </div>

      <div class="space-y-2 text-center">
        <h1 class="text-3xl font-black tracking-tight sm:text-4xl md:text-5xl">
          Hey, I'm <span class="text-primary">@pixlized</span>
        </h1>
        <p class="font-mono text-xs text-muted-foreground sm:text-sm">
          Software Developer & Creative Engineer
        </p>
      </div>

      <!-- Two Dialogs Side by Side -->
      <div class="flex w-full justify-center gap-4 pt-4">
        <!-- LinkTree Dialog Trigger -->
        <button
          id="links-dialog-trigger"
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-border bg-secondary/30 px-4 py-2.5 font-mono text-xs font-bold tracking-wide text-foreground uppercase transition-colors hover:bg-secondary/60 hover:text-primary"
        >
          <svg
            viewBox="0 0 24 24"
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M12 2v20M12 20L5 15M12 20L19 15"></path>
          </svg>
          <span>Links</span>
        </button>

        <!-- Empty Dialog Trigger -->
        <button
          id="more-dialog-trigger"
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-border bg-secondary/30 px-4 py-2.5 font-mono text-xs font-bold tracking-wide text-foreground uppercase transition-colors hover:bg-secondary/60 hover:text-primary"
        >
          <svg
            viewBox="0 0 24 24"
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M12 2v20M12 20L5 15M12 20L19 15"></path>
          </svg>
          <span>More</span>
        </button>
      </div>
    </div>

    <!-- Latest Blog Posts, YT Video, and Action Buttons -->
    <div
      class="grid w-full items-stretch gap-6 pt-2 text-left md:grid-cols-[1.2fr_0.8fr]"
    >
      <!-- Latest Video -->
      <div class="flex min-h-[380px] flex-col justify-between">
        <h2
          class="mb-3 border-b border-border pb-1 text-center font-mono text-[10px] font-bold tracking-widest text-muted-foreground/70 uppercase md:text-left"
        >
          Latest Video
        </h2>
        <div
          class="group relative flex w-full flex-1 items-center justify-center overflow-hidden rounded-lg border border-border bg-muted shadow-sm"
        >
          <div
            class="absolute inset-0 z-10 flex items-center justify-center bg-zinc-900/10 transition-colors group-hover:bg-black/40 dark:bg-black/20"
          >
            <div
              class="flex h-16 w-16 items-center justify-center rounded-xl bg-primary text-primary-foreground shadow-md transition-transform group-hover:scale-110"
            >
              <svg
                viewBox="0 0 256 256"
                class="ml-0.5 h-7 w-7"
                fill="currentColor"
              >
                <path
                  d="M228.1 121.2L76.1 33.2a8.2 8.2 0 0 0-8.3-.3A8.1 8.1 0 0 0 64 40v176a8.1 8.1 0 0 0 3.8 6.9a8.5 8.5 0 0 0 8.3-.3l152-88a8.1 8.1 0 0 0 0-13.4Z"
                ></path>
              </svg>
            </div>
          </div>
          <img
            src="https://picsum.photos/seed/youtube/800/450"
            alt="Latest Video"
            class="h-full w-full object-cover brightness-95 filter transition-transform duration-500"
          />
          <a
            href="https://youtube.com"
            target="_blank"
            rel="noopener noreferrer"
            class="absolute inset-0 z-20"
            aria-label="Watch video"></a>
        </div>
      </div>

      <!-- Right Side: Latest Blog Posts + Bigger Buttons -->
      <div class="flex min-h-[380px] flex-col justify-between space-y-3">
        <!-- Latest Blog Posts -->
        <div class="flex flex-1 flex-col">
          <h2
            class="mb-2 border-b border-border pb-1 text-center font-mono text-[10px] font-bold tracking-widest text-muted-foreground/70 uppercase md:text-left"
          >
            Latest Blog Posts
          </h2>
          <div
            class="mb-2 flex flex-1 flex-col divide-y divide-border/60 overflow-y-auto"
          >
            {
              posts.slice(0, 3).map((post) => (
                <a
                  href={post.link}
                  class="group flex flex-col justify-center py-3 first:pt-0"
                >
                  <span class="mb-1 line-clamp-2 text-sm leading-snug font-semibold tracking-tight transition-colors group-hover:text-primary">
                    {post.title}
                  </span>
                  <time class="font-mono text-[10px] text-muted-foreground/60">
                    {post.date}
                  </time>
                </a>
              ))
            }
          </div>
        </div>

        <!-- Bigger Buttons Row -->
        <div class="grid grid-cols-3 gap-2 border-t border-border/40 pt-3">
          <a
            href="/music"
            class="group flex flex-col items-center justify-center rounded-lg bg-secondary/30 px-3 py-5 text-foreground transition-colors duration-200 hover:bg-secondary/60 hover:text-primary"
          >
            <svg
              viewBox="0 0 24 24"
              class="mb-1.5 h-6 w-6 transition-transform group-hover:scale-110"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M9 18V5l12-2v13" />
              <circle cx="6" cy="18" r="3" />
              <circle cx="18" cy="18" r="3" />
            </svg>
            <span
              class="font-mono text-[10px] font-bold tracking-wide uppercase"
              >Music</span
            >
          </a>
          <a
            href="/projects"
            class="group flex flex-col items-center justify-center rounded-lg bg-secondary/30 px-3 py-5 text-foreground transition-colors duration-200 hover:bg-secondary/60 hover:text-primary"
          >
            <svg
              viewBox="0 0 256 256"
              class="mb-1.5 h-6 w-6 transition-transform group-hover:scale-110"
              fill="currentColor"
            >
              <path
                d="M216 72h-33.1a56 56 0 0 0-113.8 0H36a16 16 0 0 0-16 16v112a16 16 0 0 0 16 16h180a16 16 0 0 0 16-16V88a16 16 0 0 0-16-16ZM128 40a40 40 0 0 1 39.2 32H88.8A40 40 0 0 1 128 40ZM220 200a4 4 0 0 1-4 4H36a4 4 0 0 1-4-4V88a4 4 0 0 1 4-4h184a4 4 0 0 1 4 4Z"
              ></path>
            </svg>
            <span
              class="font-mono text-[10px] font-bold tracking-wide uppercase"
              >Projects</span
            >
          </a>
          <a
            href="/blog"
            class="group flex flex-col items-center justify-center rounded-lg bg-secondary/30 px-3 py-5 text-foreground transition-colors duration-200 hover:bg-secondary/60 hover:text-primary"
          >
            <svg
              viewBox="0 0 256 256"
              class="mb-1.5 h-6 w-6 transition-transform group-hover:scale-110"
              fill="currentColor"
            >
              <path
                d="M216 32H40a16 16 0 0 0-16 16v160a16 16 0 0 0 16 16h176a16 16 0 0 0 16-16V48a16 16 0 0 0-16-16Zm-16 160H56V56h144ZM184 96a8 8 0 0 1-8 8H80a8 8 0 0 1 0-16h96a8 8 0 0 1 8 8Z"
              ></path>
            </svg>
            <span
              class="font-mono text-[10px] font-bold tracking-wider uppercase"
              >Blog</span
            >
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- LinkTree Dialog (Hidden by default) -->
  <div
    id="links-dialog"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/10 backdrop-blur-sm"
    onclick="document.getElementById('links-dialog').classList.add('hidden')"
  >
    <div
      class="w-full max-w-md rounded-xl border border-border bg-popover p-4 text-sm text-popover-foreground shadow-2xl ring-1 ring-foreground/10 outline-none sm:max-w-sm"
      onclick="event.stopPropagation()"
    >
      <div class="flex flex-col gap-2 text-center">
        <h3 class="text-base leading-none font-medium">Connect With Me</h3>
        <p class="text-sm text-muted-foreground">
          All my social links in one place
        </p>
      </div>
      <div class="grid w-full mx-auto gap-3 py-4">
        {
          socialLinks.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-3 rounded-lg border border-border bg-secondary/30 p-3 transition-colors hover:border-primary/40 hover:bg-secondary/60"
            >
              <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <svg
                  viewBox="0 0 24 24"
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d={getIconPath(link.name.toLowerCase())} />
                </svg>
              </div>
              <span class="font-semibold tracking-tight">{link.name}</span>
            </a>
          ))
        }
      </div>
      <button
        onclick="document.getElementById('links-dialog').classList.add('hidden')"
        class="absolute top-2 right-2 flex h-6 w-6 items-center justify-center rounded-full bg-secondary/30 text-foreground transition-colors hover:bg-secondary/60"
        aria-label="Close"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- More Dialog (Hidden by default) -->
  <div
    id="more-dialog"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/10 backdrop-blur-sm"
    onclick="document.getElementById('more-dialog').classList.add('hidden')"
  >
    <div
      class="w-full max-w-md rounded-xl border border-border bg-popover p-4 text-sm text-popover-foreground shadow-2xl ring-1 ring-foreground/10 outline-none sm:max-w-sm"
      onclick="event.stopPropagation()"
    >
      <div class="flex flex-col gap-2 text-center">
        <h3 class="text-base leading-none font-medium">Coming Soon</h3>
        <p class="text-sm text-muted-foreground">
          This space is reserved for future content
        </p>
      </div>
      <div class="flex items-center justify-center py-8">
        <div class="text-center">
          <div
            class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full border-2 border-dashed border-border/60 bg-secondary/20"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-8 w-8 text-muted-foreground/60"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path d="M12 4v16M4 12h16"></path>
            </svg>
          </div>
          <p class="font-mono text-xs text-muted-foreground/60">
            Add your content here
          </p>
        </div>
      </div>
      <button
        onclick="document.getElementById('more-dialog').classList.add('hidden')"
        class="absolute top-2 right-2 flex h-6 w-6 items-center justify-center rounded-full bg-secondary/30 text-foreground transition-colors hover:bg-secondary/60"
        aria-label="Close"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Scroll Anchor to Section 2 -->
  <div class="flex w-full justify-center pt-4">
    <a
      href="#showcase"
      class="inline-flex flex-col items-center gap-1 font-mono text-[10px] tracking-widest text-muted-foreground/50 uppercase transition-colors duration-200 hover:text-primary"
    >
      <span>View Showcase</span>
      <svg
        viewBox="0 0 256 256"
        class="h-3.5 w-3.5 animate-bounce"
        fill="currentColor"
      >
        <path
          d="M128 184a8.1 8.1 0 0 1-5.7-2.3l-80-80a8.1 8.1 0 0 1 11.4-11.4l74.3 74.3l74.3-74.3a8.1 8.1 0 0 1 11.4 11.4l-80 80a8.1 8.1 0 0 1-5.7 2.3Z"
        ></path>
      </svg>
    </a>
  </div>
</section>

<script>
  // LinkTree Dialog
  document
    .getElementById("links-dialog-trigger")
    ?.addEventListener("click", () => {
      document.getElementById("links-dialog")?.classList.remove("hidden")
    })

  // More Dialog
  document
    .getElementById("more-dialog-trigger")
    ?.addEventListener("click", () => {
      document.getElementById("more-dialog")?.classList.remove("hidden")
    })
</script>
