---
import MainLayout from "@/layouts/main.astro"

const featuredProjects = [
  {
    title: "Project Alpha",
    description:
      "A high-performance web application built with Astro, Tailwind, and custom SSR streaming engines.",
    image: "https://picsum.photos/seed/alpha/600/350",
    tags: ["Astro", "TypeScript", "Tailwind"],
    link: "/projects/alpha",
  },
  {
    title: "Beta Analytics",
    description:
      "Real-time edge dashboard architecture tracking pipeline behaviors and infrastructure metrics.",
    image: "https://picsum.photos/seed/beta/600/350",
    tags: ["Next.js", "D3.js", "Prisma"],
    link: "/projects/beta",
  },
]

const musicTracks = [
  {
    title: "Neon Horizon",
    genre: "Synthwave / Cinematic",
    duration: "4:12",
    bpm: "110",
    description:
      "Analog heavy arrangement featuring Prophet-6 tracks and crisp digital drums.",
    link: "#",
  },
  {
    title: "Quantum Flux",
    genre: "Ambient / IDM",
    duration: "5:34",
    bpm: "92",
    description:
      "Generative modular patch textures coupled with deep, low-frequency polyrhythmic sub-bass layers.",
    link: "#",
  },
]

const recentPosts = [
  {
    title: "Building an Ultra-Fast Portfolio with Astro",
    date: "July 15, 2026",
    link: "/blog/astro-portfolio",
  },
  {
    title: "The Subtle Art of Dark Mode Empathy",
    date: "June 28, 2026",
    link: "/blog/dark-mode-empathy",
  },
  {
    title: "Designing Snapping Full-Height Layouts",
    date: "May 14, 2026",
    link: "/blog/snapping-layouts",
  },
]

const socialLinks = [
  {
    name: "GitHub",
    url: "https://github.com",
    icon: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>`,
  },
  {
    name: "Twitter",
    url: "https://twitter.com",
    icon: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>`,
  },
]
---

<MainLayout>
  <!-- ================= FRAME 1: OVERVIEW & MEDIA ================= -->
  <section
    data-label="Overview & Media"
    id="overview"
    class="flex h-full w-full shrink-0 snap-start flex-col items-center justify-between py-6 text-center"
  >
    <div></div>

    <div class="flex w-full max-w-4xl flex-col items-center space-y-8 px-4">
      <!-- Combined Profile Header Area -->
      <div
        class="flex w-full flex-col items-center gap-3 border-b border-border/40 pb-6"
      >
        <img
          src="/avatar.webp"
          alt="@pixlized profile image"
          class="h-20 w-20 shrink-0 rounded-md border border-primary/20 bg-muted object-cover shadow-sm"
        />
        <div class="space-y-1">
          <h1 class="text-3xl font-black tracking-tight sm:text-4xl">
            Hey, I'm <span class="text-primary">@pixlized</span>
          </h1>
          <p class="font-mono text-xs text-muted-foreground">
            Software Developer & Creative Engineer
          </p>
        </div>

        <div
          class="mt-1 flex items-center gap-3 rounded-sm border border-border bg-secondary/50 px-3 py-1.5 shadow-sm"
        >
          {
            socialLinks.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.name}
                class="text-muted-foreground transition-colors hover:text-primary"
                set:html={social.icon}
              />
            ))
          }
        </div>
      </div>

      <!-- ASYMMETRIC MEDIA & INTEGRATED NAV ROW -->
      <div
        class="grid w-full items-stretch gap-6 pt-2 text-left md:grid-cols-[1.2fr_0.8fr]"
      >
        <!-- LEFT SIDE: Big Video Module -->
        <div
          id="latest-video"
          class="flex min-h-[380px] flex-col justify-between"
        >
          <h2
            class="mb-3 border-b border-border pb-1 text-center font-mono text-[10px] font-bold tracking-widest text-muted-foreground/70 uppercase md:text-left"
          >
            Latest Video
          </h2>
          <div
            class="group relative flex w-full flex-1 items-center justify-center overflow-hidden rounded-md border border-border bg-muted shadow-sm"
          >
            <div
              class="absolute inset-0 z-10 flex items-center justify-center bg-zinc-900/10 transition-colors group-hover:bg-black/40 dark:bg-black/20"
            >
              <div
                class="flex h-12 w-12 items-center justify-center rounded-sm bg-primary text-primary-foreground shadow-md transition-transform group-hover:scale-105"
              >
                <svg
                  viewBox="0 0 256 256"
                  class="ml-0.5 h-5 w-5"
                  fill="currentColor"
                >
                  <path
                    d="M228.1 121.2L76.1 33.2a8.2 8.2 0 0 0-8.3-.3A8.1 8.1 0 0 0 64 40v176a8.1 8.1 0 0 0 3.8 6.9a8.5 8.5 0 0 0 8.3-.3l152-88a8.1 8.1 0 0 0 0-13.4Z"
                  ></path>
                </svg>
              </div>
            </div>
            <img
              src="https://picsum.photos/seed/youtube/800/450"
              alt="Latest Video Content Cover Thumbnail"
              class="h-full w-full object-cover brightness-95 filter transition-transform duration-500"
            />
            <a
              href="https://youtube.com"
              target="_blank"
              rel="noopener noreferrer"
              class="absolute inset-0 z-20"
              aria-label="Watch video"></a>
          </div>
        </div>

        <!-- RIGHT SIDE: Blogs, Project Link, and Audio/Blog Navigation Base -->
        <div class="flex min-h-[380px] flex-col justify-between space-y-3">
          <div id="latest-writing" class="flex flex-1 flex-col justify-between">
            <h2
              class="mb-2 border-b border-border pb-1 text-center font-mono text-[10px] font-bold tracking-widest text-muted-foreground/70 uppercase md:text-left"
            >
              Latest Writing
            </h2>

            <!-- Target Feed: Last 3 Blogs Loop -->
            <div
              class="mb-2 flex flex-1 flex-col justify-between divide-y divide-border/60"
            >
              {
                recentPosts.map((post) => (
                  <a
                    href={post.link}
                    class="group flex flex-col justify-center py-2 first:pt-0"
                  >
                    <span class="mb-1 line-clamp-2 text-xs leading-snug font-semibold tracking-tight transition-colors group-hover:text-primary">
                      {post.title}
                    </span>
                    <time class="font-mono text-[9px] text-muted-foreground/60">
                      {post.date}
                    </time>
                  </a>
                ))
              }
            </div>

            <!-- Standalone Project Action Button Row -->
          </div>
          <div class="mb-3">
            <a
              href="#work"
              class="group flex w-full items-center justify-center gap-2 rounded-sm border border-border bg-secondary/20 py-2 text-foreground transition-all duration-200 hover:border-primary/30 hover:bg-secondary/50 hover:text-primary"
            >
              <svg
                viewBox="0 0 256 256"
                class="h-4 w-4 transition-transform group-hover:scale-105"
                fill="currentColor"
              >
                <path
                  d="M216 72h-33.1a56 56 0 0 0-113.8 0H36a16 16 0 0 0-16 16v112a16 16 0 0 0 16 16h180a16 16 0 0 0 16-16V88a16 16 0 0 0-16-16ZM128 40a40 40 0 0 1 39.2 32H88.8A40 40 0 0 1 128 40ZM220 200a4 4 0 0 1-4 4H36a4 4 0 0 1-4-4V88a4 4 0 0 1 4-4h184a4 4 0 0 1 4 4Z"
                ></path>
              </svg>
              <span
                class="font-mono text-[10px] font-bold tracking-wide uppercase"
                >Featured Project Showcase</span
              >
            </a>
          </div>

          <!-- BOTTOM ROW: Music & Blog Split Buttons -->
          <div class="grid grid-cols-2 gap-2 border-t border-border/40 pt-3">
            <a
              href="#music"
              class="group flex flex-col items-center justify-center rounded-sm bg-secondary/30 px-2 py-2.5 text-foreground transition-colors duration-200 hover:text-primary"
            >
              <svg
                viewBox="0 0 256 256"
                class="mb-1 h-4 w-4 transition-transform group-hover:scale-105"
                fill="currentColor"
              >
                <path
                  d="M232 128a104 104 0 1 1-104-104a104.2 104.2 0 0 1 104 104Zm-24 0a80 80 0 1 0-80 80a80.1 80.1 0 0 0 80-80Z"
                ></path>
              </svg>
              <span
                class="font-mono text-[9px] font-bold tracking-wide uppercase"
                >Music Layout</span
              >
            </a>

            <a
              href="/blog"
              class="group flex flex-col items-center justify-center rounded-sm bg-secondary/30 px-2 py-2.5 text-foreground transition-colors duration-200 hover:text-primary"
            >
              <svg
                viewBox="0 0 256 256"
                class="mb-1 h-4 w-4 transition-transform group-hover:scale-105"
                fill="currentColor"
              >
                <path
                  d="M216 32H40a16 16 0 0 0-16 16v160a16 16 0 0 0 16 16h176a16 16 0 0 0 16-16V48a16 16 0 0 0-16-16Zm-16 160H56V56h144ZM184 96a8 8 0 0 1-8 8H80a8 8 0 0 1 0-16h96a8 8 0 0 1 8 8Z"
                ></path>
              </svg>
              <span
                class="font-mono text-[9px] font-bold tracking-wide uppercase"
                >Full Blog</span
              >
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- LOWER SCROLL ANCHOR -->
    <div class="flex w-full justify-center pt-4">
      <a
        href="#work"
        class="inline-flex flex-col items-center gap-1 font-mono text-[10px] tracking-widest text-muted-foreground/50 uppercase transition-colors duration-200 hover:text-primary"
      >
        <span>Showcase Architecture</span>
        <svg
          viewBox="0 0 256 256"
          class="h-3.5 w-3.5 animate-bounce"
          fill="currentColor"
        >
          <path
            d="M128 184a8.1 8.1 0 0 1-5.7-2.3l-80-80a8.1 8.1 0 0 1 11.4-11.4l74.3 74.3l74.3-74.3a8.1 8.1 0 0 1 11.4 11.4l-80 80a8.1 8.1 0 0 1-5.7 2.3Z"
          ></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- ================= FRAME 2: CENTERED EXAMPLES OF WORK & AUDIO SHOWCASE ================= -->
  <section
    data-label="Examples of Work"
    id="work"
    class="flex h-full w-full shrink-0 snap-start flex-col items-center justify-between py-6"
  >
    <div
      class="hided-scrollbar flex max-h-[85vh] w-full max-w-2xl flex-col items-center space-y-8 overflow-y-auto px-4 text-center"
    >
      <!-- SUBSECTION A: ENGINEERING ARTIFACTS -->
      <div class="w-full space-y-4">
        <div
          class="flex flex-col items-center space-y-0.5 border-b border-border pb-2"
        >
          <h2
            class="font-mono text-sm font-bold tracking-tight text-primary uppercase"
          >
            Visual Engineering Repository
          </h2>
          <span class="font-mono text-[10px] text-muted-foreground/60"
            >Selected Releases</span
          >
        </div>

        <div class="grid gap-6 text-left sm:grid-cols-2">
          {
            featuredProjects.map((project) => (
              <div class="group relative flex flex-col overflow-hidden rounded-sm border border-border bg-card shadow-sm transition-all hover:border-primary/40">
                <div class="relative aspect-[16/10] w-full overflow-hidden border-b border-border/60 bg-muted">
                  <img
                    src={project.image}
                    alt={project.title}
                    class="h-full w-full object-cover brightness-[92%] grayscale-[20%] transition-transform duration-500 group-hover:scale-[1.01] group-hover:brightness-100 group-hover:grayscale-0"
                  />
                </div>
                <div class="flex flex-1 flex-col justify-between space-y-3 p-4">
                  <div class="space-y-1">
                    <h3 class="text-sm font-bold tracking-tight transition-colors group-hover:text-primary">
                      {project.title}
                    </h3>
                    <p class="line-clamp-2 text-xs leading-normal text-muted-foreground">
                      {project.description}
                    </p>
                  </div>
                  <div class="flex flex-wrap gap-1">
                    {project.tags.map((tag) => (
                      <span class="inline-flex items-center rounded-sm border border-border/60 bg-secondary px-1.5 py-0.5 font-mono text-[9px] font-medium text-secondary-foreground">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
                <a
                  href={project.link}
                  class="absolute inset-0 z-10"
                  aria-label={`View ${project.title}`}
                />
              </div>
            ))
          }
        </div>
      </div>

      <!-- SUBSECTION B: AUDIO ARCHIVE SHOWCASE -->
      <div class="w-full space-y-4 pt-2">
        <div
          class="flex flex-col items-center space-y-0.5 border-b border-border pb-2"
        >
          <h2
            class="font-mono text-sm font-bold tracking-tight text-[hsl(var(--chart-2))] uppercase"
          >
            Audio Engineering & Tracks
          </h2>
          <span class="font-mono text-[10px] text-muted-foreground/60"
            >Modular & Hardware Output</span
          >
        </div>

        <div class="w-full space-y-2.5 text-left">
          {
            musicTracks.map((track) => (
              <div class="group relative flex items-center justify-between rounded-sm border border-border bg-card/60 p-3.5 transition-all hover:border-[hsl(var(--chart-2))]/40 hover:bg-card">
                <div class="flex min-w-0 flex-1 items-center gap-3.5">
                  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-sm border border-[hsl(var(--chart-2))]/20 bg-[hsl(var(--chart-2))]/10 text-[hsl(var(--chart-2))] transition-colors group-hover:bg-[hsl(var(--chart-2))] group-hover:text-white">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                      class="ml-0.5 h-3.5 w-3.5"
                    >
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>
                  <div class="min-w-0 space-y-0.5">
                    <div class="flex items-center gap-2">
                      <h3 class="truncate text-xs font-bold tracking-tight transition-colors group-hover:text-[hsl(var(--chart-2))]">
                        {track.title}
                      </h3>
                      <span class="shrink-0 rounded-sm border border-border/40 bg-secondary/80 px-1 font-mono text-[9px] text-muted-foreground">
                        {track.genre}
                      </span>
                    </div>
                    <p class="max-w-md truncate text-[11px] text-muted-foreground">
                      {track.description}
                    </p>
                  </div>
                </div>
                <div class="shrink-0 space-y-0.5 pl-4 text-right font-mono text-[10px] text-muted-foreground/70">
                  <div>{track.duration}</div>
                  <div class="text-[9px] text-muted-foreground/40">
                    {track.bpm} BPM
                  </div>
                </div>
                <a
                  href={track.link}
                  class="absolute inset-0"
                  aria-label={`Listen to ${track.title}`}
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- LOWER SCROLL ANCHOR -->
    <div class="flex w-full justify-center pt-2">
      <a
        href="#contact"
        class="inline-flex flex-col items-center gap-1 font-mono text-[10px] tracking-widest text-muted-foreground/50 uppercase transition-colors duration-200 hover:text-primary"
      >
        <span>Connect Channels</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2.5"
          stroke="currentColor"
          class="h-3.5 w-3.5 animate-bounce"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- ================= FRAME 3: CONTACT ME WITH MINIMAL FORM ================= -->
  <section
    data-label="Contact Me"
    id="contact"
    class="flex h-full w-full shrink-0 snap-start flex-col items-center justify-between py-6 text-center"
  >
    <div></div>

    <div class="flex w-full max-w-md flex-col items-center space-y-6 px-4">
      <div class="space-y-2">
        <h2 class="text-2xl font-black tracking-tight">
          Let's build something beautiful
        </h2>
        <p class="max-w-sm text-xs leading-relaxed text-muted-foreground">
          Seeking custom engineering deployment, sound design, or wanting to
          chat strategy? Drop a message down below.
        </p>
      </div>

      <!-- Minimal Contact Form Layer -->
      <form
        onSubmit="event.preventDefault()"
        class="w-full space-y-3 rounded-sm border border-border bg-card p-5 text-left shadow-sm"
      >
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
            >Name</label
          >
          <input
            type="text"
            placeholder="John Doe"
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2 text-xs transition-colors focus:border-primary focus:outline-none"
          />
        </div>
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
            >Email Target</label
          >
          <input
            type="email"
            placeholder="john@domain.com"
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2 text-xs transition-colors focus:border-primary focus:outline-none"
          />
        </div>
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
            >Message Details</label
          >
          <textarea
            rows="3"
            placeholder="Describe the scope of your platform idea..."
            class="w-full resize-none rounded-sm border border-border bg-secondary/40 px-3 py-2 text-xs transition-colors focus:border-primary focus:outline-none"
          ></textarea>
        </div>
        <button
          type="submit"
          class="w-full rounded-sm bg-primary py-2.5 font-mono text-xs font-bold tracking-wider text-primary-foreground uppercase shadow-sm transition-colors hover:bg-primary/90"
        >
          Transmit Message
        </button>
      </form>
    </div>

    <!-- BOTTOM RESET SCROLL ANCHOR -->
    <div class="flex w-full justify-center pt-4">
      <a
        href="#overview"
        class="inline-flex flex-col items-center gap-1 font-mono text-[10px] tracking-widest text-muted-foreground/50 uppercase transition-colors duration-200 hover:text-primary"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2.5"
          stroke="currentColor"
          class="h-3.5 w-3.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4.5 15.75l7.5-7.5 7.5 7.5"></path>
        </svg>
        <span>Back To Root Index</span>
      </a>
    </div>
  </section>
</MainLayout>
