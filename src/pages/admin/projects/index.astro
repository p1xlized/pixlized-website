---
import MainLayout from "@/layouts/main.astro"
import { db } from "@/db/db"

// Get all projects
const projects = db.prepare(`
  SELECT *
  FROM projects
  ORDER BY releasedAt DESC
`).all() as any[]
---

<MainLayout>
  <section class="flex h-full w-full flex-col items-center justify-start py-12 px-4">
    <div class="w-full max-w-4xl space-y-6">
      <!-- Header -->
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold tracking-tight">
            <span class="font-mono text-[hsl(var(--chart-1))]">📁</span> Projects
          </h1>
          <p class="mt-1 text-sm text-muted-foreground">
            Manage your projects
          </p>
        </div>
        <div class="flex gap-2">
          <a
            href="/admin/dashboard"
            class="rounded-sm border border-border bg-secondary/50 px-3 py-1.5 font-mono text-xs font-bold tracking-wider uppercase transition-colors hover:bg-secondary/80"
          >
            Dashboard
          </a>
          <a
            href="/admin/projects/new"
            class="rounded-sm border border-[hsl(var(--chart-1))] bg-[hsl(var(--chart-1))] px-3 py-1.5 font-mono text-xs font-bold tracking-wider uppercase transition-colors hover:bg-[hsl(var(--chart-1))]/90 text-white"
          >
            + New Project
          </a>
        </div>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="rounded-sm border border-border bg-card p-4 text-center">
          <div class="text-2xl font-bold">{projects.length}</div>
          <div class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
            Total Projects
          </div>
        </div>
        <div class="rounded-sm border border-border bg-card p-4 text-center">
          <div class="text-2xl font-bold">
            {db.prepare("SELECT COUNT(*) as count FROM projects WHERE isFeatured = 1").get().count}
          </div>
          <div class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
            Featured
          </div>
        </div>
        <div class="rounded-sm border border-border bg-card p-4 text-center">
          <div class="text-2xl font-bold">
            {db.prepare("SELECT COUNT(*) as count FROM projects WHERE isPersonal = 1").get().count}
          </div>
          <div class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
            Personal
          </div>
        </div>
        <div class="rounded-sm border border-border bg-card p-4 text-center">
          <div class="text-2xl font-bold">
            {db.prepare("SELECT COUNT(DISTINCT tag) as count FROM projects WHERE tag IS NOT NULL").get().count || 0}
          </div>
          <div class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
            Tags
          </div>
        </div>
      </div>

      <!-- Projects Grid -->
      <div class="rounded-sm border border-border bg-card p-6 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="font-mono text-sm font-bold tracking-tight uppercase">
            All Projects
          </h2>
          <span class="font-mono text-[10px] text-muted-foreground">
            [{projects.length} total]
          </span>
        </div>

        {projects.length === 0 ? (
          <div class="flex h-32 items-center justify-center text-muted-foreground">
            <p>No projects found. Create your first project!</p>
          </div>
        ) : (
          <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
            {projects.map((project) => (
              <div
                key={project.id}
                class="rounded-sm border border-border/40 bg-secondary/30 overflow-hidden transition-all hover:border-[hsl(var(--chart-1))]/40"
              >
                {project.cover ? (
                  <img
                    src={project.cover}
                    alt={project.title}
                    class="h-32 w-full object-cover"
                  />
                ) : (
                  <div class="h-32 w-full bg-secondary/40 flex items-center justify-center">
                    <span class="font-mono text-xs text-muted-foreground">No Cover</span>
                  </div>
                )}
                <div class="p-3">
                  <div class="flex items-center justify-between">
                    <h3 class="font-bold text-sm truncate">{project.title}</h3>
                    <span class="font-mono text-[10px] text-muted-foreground">
                      {project.tag}
                    </span>
                  </div>
                  <p class="font-mono text-[10px] text-muted-foreground mt-1 truncate">
                    {project.tech}
                  </p>
                  <div class="flex gap-2 mt-2">
                    <a
                      href={`/admin/projects/${project.id}/edit`}
                      class="flex-1 rounded-sm border border-border bg-secondary/50 px-2 py-1 font-mono text-[10px] tracking-wider uppercase transition-colors hover:bg-secondary/80 text-center"
                    >
                      Edit
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <script>
    // Check auth on page load
    document.addEventListener("DOMContentLoaded", () => {
      const isLoggedIn =
        sessionStorage.getItem("admin_logged_in") ||
        localStorage.getItem("admin_token")
      if (!isLoggedIn) {
        const adminSeed = import.meta.env.ADMIN_SEED || "pixlized-secret-2026"
        window.location.href = `/secret/${adminSeed}/admin`
      }
    })
  </script>
</MainLayout>
