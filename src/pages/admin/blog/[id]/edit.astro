---
import MainLayout from "@/layouts/main.astro"
const { id } = Astro.params
---

<MainLayout>
  <section class="flex h-full w-full flex-col items-center justify-start py-12 px-4">
    <div class="w-full max-w-3xl space-y-6">
      <!-- Header -->
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold tracking-tight">
            <span class="font-mono text-[hsl(var(--chart-2))]">✏️</span> Edit Blog Post
          </h1>
          <p class="mt-1 text-sm text-muted-foreground">
            Edit post: <span id="post-id" class="font-mono text-primary">{id}</span>
          </p>
        </div>
        <div class="flex gap-2">
          <a
            href="/admin/blog"
            class="rounded-sm border border-border bg-secondary/50 px-3 py-1.5 font-mono text-xs font-bold tracking-wider uppercase transition-colors hover:bg-secondary/80"
          >
            Back
          </a>
        </div>
      </div>

      <!-- Form -->
      <form
        id="edit-blog-form"
        class="rounded-sm border border-border bg-card p-6 space-y-6 shadow-sm"
      >
        <input type="hidden" id="blog-id" value={id} />

        <!-- Title -->
        <div class="space-y-1">
          <label class="font-mono text-[10px] tracking-wider uppercase text-muted-foreground/80">
            Title *
          </label>
          <input
            type="text"
            id="blog-title"
            name="title"
            placeholder="Post title..."
            required
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary/20"
          />
        </div>

        <!-- Description -->
        <div class="space-y-1">
          <label class="font-mono text-[10px] tracking-wider uppercase text-muted-foreground/80">
            Description
          </label>
          <textarea
            id="blog-description"
            name="description"
            rows={2}
            placeholder="Brief description of the post..."
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary/20 resize-none"
          />
        </div>

        <!-- Publish Date -->
        <div class="space-y-1">
          <label class="font-mono text-[10px] tracking-wider uppercase text-muted-foreground/80">
            Publish Date *
          </label>
          <input
            type="date"
            id="blog-pubDate"
            name="pubDate"
            required
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary/20"
          />
        </div>

        <!-- Tags -->
        <div class="space-y-1">
          <label class="font-mono text-[10px] tracking-wider uppercase text-muted-foreground/80">
            Tags (comma-separated)
          </label>
          <input
            type="text"
            id="blog-tags"
            name="tags"
            placeholder="tag1, tag2, tag3"
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary/20"
          />
          <p class="font-mono text-[10px] text-muted-foreground/60">
            Enter tags separated by commas
          </p>
        </div>

        <!-- Cover Image Upload -->
        <div class="space-y-1">
          <label class="font-mono text-[10px] tracking-wider uppercase text-muted-foreground/80">
            Cover Image
          </label>
          <div class="flex gap-2">
            <input
              type="file"
              id="blog-cover-upload"
              accept="image/*"
              class="flex-1 rounded-sm border border-border bg-secondary/40 px-3 py-2 text-sm file:mr-2 file:rounded-sm file:border-0 file:bg-primary/10 file:px-3 file:py-1 file:text-sm file:font-mono file:text-primary"
            />
            <button
              type="button"
              onclick="uploadFile('blog-cover-upload', 'blog-cover-url', 'image', 'blog')"
              class="rounded-sm border border-border bg-secondary/50 px-3 py-2 font-mono text-xs tracking-wider uppercase transition-colors hover:bg-secondary/80"
            >
              Upload
            </button>
          </div>
          <input
            type="hidden"
            id="blog-cover-url"
            name="cover"
          />
          <div id="blog-cover-preview" class="mt-2"></div>
        </div>

        <!-- Content -->
        <div class="space-y-1">
          <label class="font-mono text-[10px] tracking-wider uppercase text-muted-foreground/80">
            Content *
          </label>
          <textarea
            id="blog-body"
            name="body"
            rows={15}
            placeholder="Write your blog post content in Markdown..."
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary/20 resize-none font-mono text-[12px]"
          />
          <p class="font-mono text-[10px] text-muted-foreground/60">
            Supports Markdown formatting
          </p>
        </div>

        <!-- Submit -->
        <div class="flex gap-2">
          <button
            type="submit"
            class="flex-1 rounded-sm bg-[hsl(var(--chart-2))] py-2.5 font-mono text-sm font-bold tracking-wider uppercase text-white transition-all hover:bg-[hsl(var(--chart-2))]/90"
          >
            Update Post
          </button>
          <button
            type="button"
            onclick="window.location.href='/admin/blog'"
            class="rounded-sm border border-border bg-secondary/50 px-4 py-2.5 font-mono text-sm font-bold tracking-wider uppercase transition-colors hover:bg-secondary/80"
          >
            Cancel
          </button>
          <button
            type="button"
            onclick="confirmDelete()"
            class="rounded-sm border border-red-500/30 bg-red-500/10 px-4 py-2.5 font-mono text-sm font-bold tracking-wider uppercase text-red-500 transition-colors hover:bg-red-500/20"
          >
            Delete
          </button>
        </div>
      </form>
    </div>
  </section>

  <script>
    // Check auth on page load
    document.addEventListener("DOMContentLoaded", async () => {
      const isLoggedIn =
        sessionStorage.getItem("admin_logged_in") ||
        localStorage.getItem("admin_token")

      if (!isLoggedIn) {
        const adminSeed = import.meta.env.ADMIN_SEED || "pixlized-secret-2026"
        window.location.href = `/secret/${adminSeed}/admin`
        return
      }

      // Load post data
      await loadPostData()
    })

    async function loadPostData() {
      const token = localStorage.getItem('admin_token')
      const postId = '{id}'

      try {
        const response = await fetch('/api/admin/blog', {
          headers: {
            'Authorization': `Bearer ${token}`
          }
        })

        if (!response.ok) {
          throw new Error('Failed to fetch posts')
        }

        const { posts } = await response.json()
        const post = posts.find((p: any) => p.id === postId)

        if (!post) {
          alert('Post not found')
          window.location.href = '/admin/blog'
          return
        }

        // Populate form fields
        const titleInput = document.getElementById('blog-title') as HTMLInputElement
        const descriptionInput = document.getElementById('blog-description') as HTMLTextAreaElement
        const pubDateInput = document.getElementById('blog-pubDate') as HTMLInputElement
        const tagsInput = document.getElementById('blog-tags') as HTMLInputElement
        const coverUrlInput = document.getElementById('blog-cover-url') as HTMLInputElement
        const bodyInput = document.getElementById('blog-body') as HTMLTextAreaElement
        const coverPreview = document.getElementById('blog-cover-preview')

        if (titleInput) titleInput.value = post.title || ''
        if (descriptionInput) descriptionInput.value = post.description || ''
        if (pubDateInput) pubDateInput.value = post.pubDate ? new Date(post.pubDate).toISOString().split('T')[0] : ''
        if (tagsInput) tagsInput.value = post.tags ? post.tags.join(', ') : ''
        if (coverUrlInput) coverUrlInput.value = post.cover || ''
        if (bodyInput) bodyInput.value = post.body || ''

        // Show cover preview if URL exists
        if (post.cover && coverPreview) {
          coverPreview.innerHTML = `
            <div class="relative">
              <img src="${post.cover}" class="h-32 w-auto rounded-sm object-cover" />
              <button
                onclick="clearUpload('blog-cover-upload', 'blog-cover-url', 'blog-cover-preview')"
                class="absolute top-1 right-1 h-5 w-5 rounded-full bg-red-500/20 flex items-center justify-center text-red-500 hover:bg-red-500/40"
              >
                ✕
              </button>
            </div>
          `
        }

      } catch (error) {
        alert('Error loading post: ' + error.message)
        window.location.href = '/admin/blog'
      }
    }

    // Form submission
    const form = document.getElementById('edit-blog-form')
    form?.addEventListener('submit', async (e) => {
      e.preventDefault()

      const id = (document.getElementById('blog-id') as HTMLInputElement).value
      const title = (document.getElementById('blog-title') as HTMLInputElement).value
      const description = (document.getElementById('blog-description') as HTMLTextAreaElement).value
      const pubDate = (document.getElementById('blog-pubDate') as HTMLInputElement).value
      const tags = (document.getElementById('blog-tags') as HTMLInputElement).value
      const cover = (document.getElementById('blog-cover-url') as HTMLInputElement).value
      const body = (document.getElementById('blog-body') as HTMLTextAreaElement).value

      if (!title || !pubDate || !body) {
        alert('Please fill in all required fields')
        return
      }

      const token = localStorage.getItem('admin_token')

      try {
        const response = await fetch('/api/admin/blog', {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify({
            id,
            title,
            description,
            pubDate,
            tags: tags.split(',').map((t: string) => t.trim()).filter(Boolean),
            cover,
            body
          })
        })

        if (response.ok) {
          window.location.href = '/admin/blog'
        } else {
          const error = await response.json()
          alert(error.error || 'Failed to update post')
        }
      } catch (err) {
        alert('Error updating post: ' + err)
      }
    })

    async function confirmDelete() {
      if (!confirm('Are you sure you want to delete this post? This cannot be undone.')) return

      const id = (document.getElementById('blog-id') as HTMLInputElement).value
      const token = localStorage.getItem('admin_token')

      try {
        const response = await fetch('/api/admin/blog', {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify({ id })
        })

        if (response.ok) {
          window.location.href = '/admin/blog'
        } else {
          const error = await response.json()
          alert(error.error || 'Failed to delete post')
        }
      } catch (err) {
        alert('Error deleting post: ' + err)
      }
    }

    // File upload function
    async function uploadFile(inputId: string, urlInputId: string, fileType: string, dir: string) {
      const fileInput = document.getElementById(inputId) as HTMLInputElement
      const urlInput = document.getElementById(urlInputId) as HTMLInputElement
      const previewContainer = document.getElementById(`${inputId}-preview`)

      if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
        alert('Please select a file first')
        return
      }

      const file = fileInput.files[0]
      const token = localStorage.getItem('admin_token')

      try {
        const formData = new FormData()
        formData.append('file', file)
        formData.append('type', fileType)
        formData.append('dir', dir)

        const response = await fetch('/api/upload', {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`
          },
          body: formData
        })

        if (response.ok) {
          const result = await response.json()
          urlInput.value = result.url

          // Show preview for images
          if (fileType === 'image' && previewContainer) {
            previewContainer.innerHTML = `
              <div class="relative">
                <img src="${result.url}" class="h-32 w-auto rounded-sm object-cover" />
                <button
                  onclick="clearUpload('${inputId}', '${urlInputId}', '${inputId}-preview')"
                  class="absolute top-1 right-1 h-5 w-5 rounded-full bg-red-500/20 flex items-center justify-center text-red-500 hover:bg-red-500/40"
                >
                  ✕
                </button>
              </div>
            `
          }

          alert('File uploaded successfully!')
        } else {
          const error = await response.json()
          alert(error.error || 'Failed to upload file')
        }
      } catch (err) {
        alert('Error uploading file: ' + err)
      }
    }

    function clearUpload(inputId: string, urlInputId: string, previewId: string) {
      const fileInput = document.getElementById(inputId) as HTMLInputElement
      const urlInput = document.getElementById(urlInputId) as HTMLInputElement
      const previewContainer = document.getElementById(previewId)

      if (fileInput) fileInput.value = ''
      if (urlInput) urlInput.value = ''
      if (previewContainer) previewContainer.innerHTML = ''
    }
  </script>
</MainLayout>
