---
import MainLayout from "@/layouts/main.astro"
import { db } from "@/db/db"
---

<MainLayout>
  <section class="flex h-full w-full flex-col items-center justify-start py-12 px-4">
    <div class="w-full max-w-4xl space-y-6">
      <!-- Header -->
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold tracking-tight">
            <span class="font-mono text-[hsl(var(--chart-2))]">📝</span> Blog Posts
          </h1>
          <p class="mt-1 text-sm text-muted-foreground">
            Manage your blog content
          </p>
        </div>
        <div class="flex gap-2">
          <a
            href="/admin/blog/new"
            class="rounded-sm bg-[hsl(var(--chart-2))] px-3 py-1.5 font-mono text-xs font-bold tracking-wider uppercase text-white transition-all hover:bg-[hsl(var(--chart-2))]/90"
          >
            + New Post
          </a>
          <a
            href="/admin/dashboard"
            class="rounded-sm border border-border bg-secondary/50 px-3 py-1.5 font-mono text-xs font-bold tracking-wider uppercase transition-colors hover:bg-secondary/80"
          >
            Back
          </a>
        </div>
      </div>

      <!-- Blog Posts List -->
      <div class="space-y-4 rounded-sm border border-border bg-card p-6">
        <h2 class="font-mono text-sm font-bold tracking-tight uppercase">
          All Posts
        </h2>

        <div id="blog-posts-list" class="space-y-2">
          <!-- Posts will be loaded via JavaScript -->
          <div class="flex items-center justify-center p-8">
            <div class="animate-spin rounded-full h-6 w-6 border-2 border-primary border-t-transparent"></div>
            <span class="ml-2 text-sm text-muted-foreground">Loading...</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Check auth on page load
    document.addEventListener("DOMContentLoaded", async () => {
      const isLoggedIn =
        sessionStorage.getItem("admin_logged_in") ||
        localStorage.getItem("admin_token")

      if (!isLoggedIn) {
        const adminSeed = import.meta.env.ADMIN_SEED || "pixlized-secret-2026"
        window.location.href = `/secret/${adminSeed}/admin`
        return
      }

      // Load blog posts
      await loadBlogPosts()
    })

    async function loadBlogPosts() {
      const token = localStorage.getItem('admin_token')
      const container = document.getElementById('blog-posts-list')

      if (!container) return

      try {
        const response = await fetch('/api/admin/blog', {
          headers: {
            'Authorization': `Bearer ${token}`
          }
        })

        if (!response.ok) {
          throw new Error('Failed to fetch posts')
        }

        const { posts } = await response.json()

        if (posts.length === 0) {
          container.innerHTML = `
            <div class="flex h-40 shrink-0 items-center justify-center rounded-xs border border-dashed border-border text-center">
              <p class="font-mono text-xs text-muted-foreground">
                NO POSTS FOUND
              </p>
            </div>
          `
          return
        }

        container.innerHTML = posts.map((post: any) => `
          <div class="flex items-center justify-between rounded-sm p-2 transition-colors hover:bg-secondary/50 border border-border/50">
            <div class="flex items-center gap-3">
              <div class="flex-shrink-0 w-8 h-8 rounded-sm bg-secondary/50 flex items-center justify-center">
                <span class="font-mono text-xs">📄</span>
              </div>
              <div class="min-w-0 flex-1">
                <div class="text-sm font-semibold">${post.title || 'Untitled'}</div>
                <div class="font-mono text-[10px] text-muted-foreground">
                  ${post.id} • ${new Date(post.pubDate).toLocaleDateString()}
                </div>
              </div>
            </div>
            <div class="flex gap-2">
              <a
                href="/admin/blog/${post.id}/edit"
                class="font-mono text-[10px] tracking-wider text-muted-foreground uppercase hover:text-primary"
              >
                Edit
              </a>
              <a
                href="/blog/${post.id}"
                class="font-mono text-[10px] tracking-wider text-muted-foreground uppercase hover:text-primary"
              >
                View
              </a>
              <button
                onclick="deletePost('${post.id}')"
                class="font-mono text-[10px] tracking-wider text-red-500 uppercase hover:text-red-400"
              >
                Delete
              </button>
            </div>
          </div>
        `).join('')

      } catch (error) {
        container.innerHTML = `
          <div class="flex h-40 shrink-0 items-center justify-center rounded-xs border border-dashed border-border text-center">
            <p class="font-mono text-xs text-muted-foreground">
              Error loading posts: ${error.message}
            </p>
          </div>
        `
      }
    }

    async function deletePost(id: string) {
      if (!confirm('Are you sure you want to delete this post?')) return

      const token = localStorage.getItem('admin_token')

      try {
        const response = await fetch('/api/admin/blog', {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify({ id })
        })

        if (response.ok) {
          await loadBlogPosts()
        } else {
          const error = await response.json()
          alert(error.error || 'Failed to delete post')
        }
      } catch (err) {
        alert('Error deleting post: ' + err)
      }
    }
  </script>
</MainLayout>
