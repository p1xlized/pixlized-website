---
import Layout from "../../layouts/main.astro"
import { db } from "../../db/db"
import "@/styles/global.css"

let errorMessage = ""

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData()
    const title = formData.get("title")?.toString()
    const description = formData.get("description")?.toString()
    const link = formData.get("link")?.toString()
    const image = formData.get("image")?.toString() || null
    const tagsRaw = formData.get("tags")?.toString() || ""
    const featured = formData.get("featured") === "true" ? 1 : 0

    if (title && description && link) {
      const tags = tagsRaw
        .split(",")
        .map((t) => t.trim())
        .filter(Boolean)

      // Safe parameter-bound SQL entry insertion
      db.prepare(
        `
        INSERT INTO projects (title, description, link, image, tags, featured)
        VALUES (?, ?, ?, ?, ?, ?)
      `
      ).run(title, description, link, image, JSON.stringify(tags), featured)

      return Astro.redirect("/admin")
    }
  } catch (error) {
    errorMessage = "Could not save database record."
  }
}
---

<Layout title="Admin - Create Project">
  <main class="mx-auto max-w-xl bg-black px-6 py-16 text-white">
    <div class="mb-6">
      <a href="/admin" class="text-xs text-zinc-400 hover:underline"
        >← Cancel & Back</a
      >
      <h1 class="mt-2 text-2xl font-bold">Add New Entry</h1>
    </div>

    {
      errorMessage && (
        <div class="mb-4 rounded border border-red-500/20 bg-red-500/10 p-3 text-sm text-red-400">
          {errorMessage}
        </div>
      )
    }

    <form method="POST" class="space-y-4">
      <div>
        <label class="mb-1 block text-sm text-zinc-300">Title</label>
        <input
          type="text"
          name="title"
          required
          class="w-full rounded border border-zinc-700 bg-zinc-800 p-2 text-white focus:border-white focus:outline-none"
        />
      </div>
      <div>
        <label class="mb-1 block text-sm text-zinc-300">Description</label>
        <textarea
          name="description"
          rows="3"
          required
          class="w-full rounded border border-zinc-700 bg-zinc-800 p-2 text-white focus:border-white focus:outline-none"
        ></textarea>
      </div>
      <div>
        <label class="mb-1 block text-sm text-zinc-300"
          >Image URL (Optional)</label
        >
        <input
          type="url"
          name="image"
          class="w-full rounded border border-zinc-700 bg-zinc-800 p-2 text-white focus:border-white focus:outline-none"
        />
      </div>
      <div>
        <label class="mb-1 block text-sm text-zinc-300"
          >Tags (Comma Separated)</label
        >
        <input
          type="text"
          name="tags"
          placeholder="Rust, WebAssembly"
          class="w-full rounded border border-zinc-700 bg-zinc-800 p-2 text-white focus:border-white focus:outline-none"
        />
      </div>
      <div>
        <label class="mb-1 block text-sm text-zinc-300"
          >Project Target Link</label
        >
        <input
          type="url"
          name="link"
          required
          class="w-full rounded border border-zinc-700 bg-zinc-800 p-2 text-white focus:border-white focus:outline-none"
        />
      </div>
      <div class="flex items-center space-x-2 pt-2">
        <input
          type="checkbox"
          id="featured"
          name="featured"
          value="true"
          class="rounded border-zinc-700 bg-zinc-800 text-white focus:ring-0"
        />
        <label htmlFor="featured" class="text-sm text-zinc-300 select-none"
          >Feature this on main view</label
        >
      </div>

      <button
        type="submit"
        class="w-full rounded-md bg-white py-2 pt-2 font-medium text-black transition-colors hover:bg-neutral-200"
      >
        Publish Project
      </button>
    </form>
  </main>
</Layout>
