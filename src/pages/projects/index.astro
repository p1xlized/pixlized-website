---
import MainLayout from "../../layouts/main.astro"
import { db } from "../../db/db"
import ProjectCard from "../../components/Projects/ProjectCard.astro"
import "@/styles/global.css"

const url = Astro.url
const searchParams = new URLSearchParams(url.search)
const searchQuery = searchParams.get("q") || ""
const tagFilter = searchParams.get("tag") || "All"

const rawProjects = db
  .prepare("SELECT * FROM projects ORDER BY releasedAt DESC")
  .all() as any[]

const allProjects = rawProjects.map((row) => ({
  id: row.id,
  title: row.title,
  date: row.date,
  tag: row.tag as "MOBILE" | "WEB" | "GAME",
  cover: row.cover,
  isVideo: row.isVideo === 1,
  isPersonal: row.isPersonal === 1,
  stack: row.stack ? JSON.parse(row.stack) : [],
  description: row.description,
}))

const allTags = [
  "All",
  ...new Set(allProjects.map((p) => p.tag).filter(Boolean)),
]

const filteredProjects = allProjects.filter((project) => {
  const matchesSearch =
    !searchQuery ||
    project.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
    project.description?.toLowerCase().includes(searchQuery.toLowerCase()) ||
    project.stack.some((tech: string) =>
      tech.toLowerCase().includes(searchQuery.toLowerCase())
    )
  const matchesTag = tagFilter === "All" || project.tag === tagFilter
  return matchesSearch && matchesTag
})

// Pagination - 6 projects per page
const projectsPerPage = 6
const currentPage = Number(searchParams.get("page") || "1")
const totalPages = Math.ceil(filteredProjects.length / projectsPerPage)
const paginatedProjects = filteredProjects.slice(
  (currentPage - 1) * projectsPerPage,
  currentPage * projectsPerPage
)

// Build URL with query parameters
function buildUrl(params: Record<string, string | number>): string {
  const urlParams = new URLSearchParams()
  if (params.q) urlParams.set("q", String(params.q))
  if (params.tag && params.tag !== "All") urlParams.set("tag", String(params.tag))
  if (params.page && Number(params.page) > 1) urlParams.set("page", String(params.page))
  return `?${urlParams.toString()}`
}
---

<MainLayout>
  <section
    data-label="Projects"
    class="flex min-h-[calc(100vh-140px)] w-full flex-col"
  >
    <div
      class="mx-auto flex w-full max-w-7xl flex-1 flex-col overflow-y-auto px-4 py-4 sm:px-6 lg:px-8"
    >
      <!-- HEADER -->
      <div class="mb-4 text-center">
        <h1 class="text-2xl font-black tracking-tight">Projects</h1>
        <p class="mt-2 font-mono text-xs text-muted-foreground">
          {filteredProjects.length} projects found
          {searchQuery && ` for "${searchQuery}"`}
          {tagFilter !== "All" && ` in ${tagFilter}`}
        </p>
      </div>

      <!-- FILTER CONTROLS - At the top -->
      <div class="mb-6 flex flex-col items-center justify-center gap-4">
        <!-- Search Input - Real-time filtering -->
        <div class="relative w-full max-w-md">
          <svg
            class="absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-muted-foreground"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input
            id="search-input"
            type="text"
            value={searchQuery}
            placeholder="Search projects..."
            class="w-full rounded-lg border border-border bg-background px-3 py-2 pl-10 text-sm placeholder:text-muted-foreground transition-all focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none"
          />
        </div>

        <!-- Tag Filters -->
        <div class="flex flex-wrap justify-center gap-2">
          {
            allTags.map((tag) => {
              const isActive = tag === tagFilter
              const href = buildUrl({ q: searchQuery, tag, page: 1 })
              return (
                <a
                  href={href}
                  class:list={[
                    "rounded-lg border px-3 py-1 text-xs font-medium transition-colors",
                    isActive
                      ? "border-primary bg-primary text-primary-foreground"
                      : "border-border bg-background text-muted-foreground hover:border-primary/40 hover:text-foreground",
                  ]}
                >
                  {tag}
                </a>
              )
            })
          }
        </div>
      </div>

      <!-- PROJECTS GRID - Always at top, perfectly centered -->
      <div class="flex w-full flex-1 flex-col items-center justify-start">
        {
          filteredProjects.length === 0 ? (
            <div class="flex h-64 w-full items-center justify-center rounded-lg border border-dashed border-border text-center">
              <p class="font-mono text-xs text-muted-foreground">
                NO PROJECTS FOUND
              </p>
            </div>
          ) : (
            <div class="w-full max-w-7xl px-2 sm:px-4">
              <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 place-items-center">
                {paginatedProjects.map((project) => (
                  <div class="w-full max-w-sm" key={project.id}>
                    <ProjectCard project={project} />
                  </div>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <!-- PAGINATION - At the bottom with Lucide arrow icons -->
      {totalPages > 1 && (
        <div class="mt-6 flex items-center justify-center">
          <div class="flex items-center justify-center gap-2">
            <a
              href={buildUrl({ q: searchQuery, tag: tagFilter, page: currentPage - 1 })}
              class:list={[
                "flex h-8 w-8 items-center justify-center rounded-lg border transition-colors",
                currentPage <= 1
                  ? "border-border/50 bg-background/50 text-muted-foreground/50 cursor-not-allowed opacity-50"
                  : "border-border bg-background text-foreground hover:border-primary/40 hover:bg-secondary/30"
              ]}
              aria-label="Previous page"
            >
              <!-- Lucide Chevron Left -->
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
            </a>

            <span class="font-mono text-xs text-muted-foreground px-2">
              {currentPage} / {totalPages}
            </span>

            <a
              href={buildUrl({ q: searchQuery, tag: tagFilter, page: currentPage + 1 })}
              class:list={[
                "flex h-8 w-8 items-center justify-center rounded-lg border transition-colors",
                currentPage >= totalPages
                  ? "border-border/50 bg-background/50 text-muted-foreground/50 cursor-not-allowed opacity-50"
                  : "border-border bg-background text-foreground hover:border-primary/40 hover:bg-secondary/30"
              ]}
              aria-label="Next page"
            >
              <!-- Lucide Chevron Right -->
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Client-side real-time search with Astro transitions support -->
  <script>
    (() => {
      const searchInput = document.getElementById('search-input')
      const currentTag = new URLSearchParams(window.location.search).get('tag') || 'All'
      const currentQuery = new URLSearchParams(window.location.search).get('q') || ''

      if (searchInput) {
        // Set initial value
        searchInput.value = currentQuery

        // Debounce function
        let timeout: ReturnType<typeof setTimeout>

        searchInput.addEventListener('input', (e) => {
          clearTimeout(timeout)
          timeout = setTimeout(() => {
            const value = (e.target as HTMLInputElement).value
            const url = new URL(window.location.href)
            url.searchParams.set('q', value)
            url.searchParams.set('tag', currentTag)
            url.searchParams.set('page', '1')

            // Use Astro's client-side navigation if available
            if (typeof window !== 'undefined' && window.astroNavigate) {
              window.astroNavigate(url.toString(), { history: 'push' })
            } else {
              // Fallback to regular navigation
              window.location.href = url.toString()
            }
          }, 300) // 300ms debounce
        })
      }
    })()
  </script>
</MainLayout>
