---
import "@/styles/global.css"
import { ClientRouter } from "astro:transitions"

interface Props {
  title?: string
  description?: string
  ogTitle?: string
  ogDescription?: string
  ogUrl?: string
  ogImage?: string
  canonical?: string
}

const {
  title = "@pixlized - Software Developer & Creative Engineer",
  description = "Portfolio of @pixlized - Software Developer & Creative Engineer specializing in web development, game engines, and AI solutions.",
  ogTitle,
  ogDescription,
  ogUrl,
  ogImage,
  canonical,
} = Astro.props

const url = Astro.url
const baseUrl = "https://pixlized.net"
const currentUrl = url.origin || baseUrl
const finalOgTitle = ogTitle || title
const finalOgDescription = ogDescription || description
const finalOgUrl = ogUrl || currentUrl
const finalOgImage = ogImage || `${baseUrl}/avatar.webp`
const finalCanonical = canonical || currentUrl

// Get theme from cookie to prevent flash on page load
const themeCookie = Astro.cookies.get("theme")?.value
const isDarkTheme = themeCookie === "dark"
const htmlClasses = [
  "h-full",
  "overflow-hidden",
  "select-none",
  isDarkTheme ? "dark" : "",
]
  .filter(Boolean)
  .join(" ")
---

<html lang="en" class={htmlClasses}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ClientRouter />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.ico" />

    <!-- Primary Meta Tags -->
    <title>{finalOgTitle}</title>
    <meta name="title" content={finalOgTitle} />
    <meta name="description" content={finalOgDescription} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={finalOgUrl} />
    <meta property="og:title" content={finalOgTitle} />
    <meta property="og:description" content={finalOgDescription} />
    <meta property="og:image" content={finalOgImage} />
    <meta property="og:site_name" content="@pixlized" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalOgTitle} />
    <meta name="twitter:description" content={finalOgDescription} />
    <meta name="twitter:image" content={finalOgImage} />
    <meta name="twitter:creator" content="@pixlized" />
    <meta name="twitter:site" content="@pixlized" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "@pixlized",
        "url": "https://pixlized.net",
        "image": "https://pixlized.net/avatar.webp",
        "description": "Software Developer & Creative Engineer specializing in web development, game engines, and AI solutions",
        "sameAs": [
          "https://github.com/pixlized",
          "https://twitter.com/pixlized",
          "https://bsky.app/pixlized"
        ],
        "hasOccupation": {
          "@type": "Occupation",
          "name": "Software Developer"
        },
        "knowsAbout": [
          "Web Development",
          "TypeScript",
          "Python",
          "React",
          "Astro",
          "Game Development",
          "AI/ML",
          "Cloud Computing"
        ]
      }
    </script>

    <!-- Canonical URL -->
    <link rel="canonical" href={finalCanonical} />

    <!-- Theme Color -->
    <meta name="theme-color" content="#3b82f6" />

    <!-- Robots -->
    <meta name="robots" content="index, follow" />

    <!-- Google Search Console Verification -->
    <meta
      name="google-site-verification"
      content="YOUR_GOOGLE_VERIFICATION_CODE"
    />

    <!-- Bing Webmaster Tools Verification -->
    <meta name="msvalidate.01" content="YOUR_BING_VERIFICATION_CODE" />

    <script is:inline>
      // Theme initialization - runs immediately on page load
      ;(() => {
        const getThemePreference = () => {
          if (
            typeof localStorage !== "undefined" &&
            localStorage.getItem("theme")
          ) {
            return localStorage.getItem("theme")
          }
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light"
        }
        const isDark = getThemePreference() === "dark"
        document.documentElement.classList[isDark ? "add" : "remove"]("dark")
      })()
    </script>

    <script>
      // Theme persistence and page transition handling
      if (typeof localStorage !== "undefined") {
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains("dark")
          localStorage.setItem("theme", isDark ? "dark" : "light")
          // Also set cookie so server can read it on next page load
          document.cookie = `theme=${isDark ? "dark" : "light"}; path=/; max-age=${60 * 60 * 24 * 365}`
        })
        observer.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["class"],
        })

        // Handle theme on Astro page transitions
        document.addEventListener("astro:after-swap", () => {
          const savedTheme = localStorage.getItem("theme")
          if (savedTheme) {
            const isDark = savedTheme === "dark"
            document.documentElement.classList[isDark ? "add" : "remove"](
              "dark"
            )
          }
        })

        document.addEventListener("astro:before-swap", () => {
          const isDark = document.documentElement.classList.contains("dark")
          localStorage.setItem("theme", isDark ? "dark" : "light")
        })
      }
    </script>
  </head>

  <body
    class="mx-auto flex h-full max-w-3xl flex-col overflow-hidden bg-background px-4 text-foreground antialiased sm:px-6"
  >
    <!-- Parallax Background - Minimal, disabled on mobile -->
    <div class="parallax-container">
      <div class="parallax-layer layer-1" data-speed="0.1"></div>
      <div class="parallax-layer layer-2" data-speed="0.2"></div>
      <div class="particle"></div>
      <div class="particle"></div>
      <div class="particle"></div>
    </div>

    <!-- 1. FIXED NAVIGATION BAR -->
    <header
      class="relative z-50 flex h-20 shrink-0 flex-col justify-center bg-transparent py-4"
    >
      <div class="flex w-full items-center justify-between">
        <div class="flex flex-col">
          <a
            href="/"
            class="font-bold tracking-tight text-primary transition-colors hover:text-muted-foreground"
          >
            @pixlized
          </a>
          <!-- DYNAMIC SECTION LABEL STATE -->
          <span
            id="current-section-label"
            class="font-mono text-[10px] tracking-widest text-muted-foreground/70 uppercase transition-all duration-300"
          >
            Overview
          </span>
        </div>

        <nav class="flex items-center gap-6">
          <a
            href="/projects"
            class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
          >
            Projects
          </a>
          <a
            href="/blog"
            class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
          >
            Blog
          </a>
          <a
            href="/music"
            class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
          >
            Music
          </a>

          <button
            id="theme-toggle"
            class="rounded-md border border-input bg-background p-2 transition-colors hover:bg-accent hover:text-accent-foreground"
            aria-label="Toggle Theme"
          >
            <svg
              id="theme-toggle-sun"
              class="hidden h-[1.2rem] w-[1.2rem] dark:block"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 3v2.25m0 13.5V21m8.966-8.966h-2.25m-13.5 0h-2.25m15.364-6.364l-1.591 1.591M6.343 17.657l-1.591 1.591m15.364 0l-1.591-1.591M6.343 6.343L4.752 4.752M12 7.5a4.5 4.5 0 100 9 4.5 4.5 0 000-9z"
              ></path>
            </svg>
            <svg
              id="theme-toggle-moon"
              class="block h-[1.2rem] w-[1.2rem] dark:hidden"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
              ></path>
            </svg>
          </button>
        </nav>
      </div>

      <!-- SCROLL PROGRESS BAR INDICATOR -->
      <div
        class="absolute bottom-0 left-0 h-[2px] w-0 bg-primary transition-all duration-75"
        id="scroll-progress"
      >
      </div>
    </header>

    <!-- 2. SCROLLABLE SNAP CONTAINER -->
    <main
      id="scrollable-content"
      class="hided-scrollbar flex-1 snap-y snap-mandatory overflow-y-auto scroll-smooth"
    >
      <slot />
    </main>

    <!-- 3. FIXED FOOTER -->
    <footer
      class="z-50 flex shrink-0 justify-between bg-transparent py-4 text-xs text-muted-foreground"
    >
      <p>© 2026 @pixlized. Built with Astro & Shadcn.</p>
      <div class="flex gap-4">
        <a href="https://github.com" class="transition hover:text-foreground"
          >GitHub</a
        >
        <a href="https://twitter.com" class="transition hover:text-foreground"
          >Twitter</a
        >
      </div>
    </footer>

    <script>
      const setupInteractions = () => {
        // Theme Toggle
        document
          .getElementById("theme-toggle")
          ?.addEventListener("click", () => {
            const element = document.documentElement
            element.classList.toggle("dark")
            localStorage.setItem(
              "theme",
              element.classList.contains("dark") ? "dark" : "light"
            )
          })

        const mainContent = document.getElementById("scrollable-content")
        const progressBar = document.getElementById("scroll-progress")
        const labelIndicator = document.getElementById("current-section-label")

        if (mainContent && progressBar) {
          // Scroll Progress calculation
          mainContent.addEventListener("scroll", () => {
            const scrollTop = mainContent.scrollTop
            const scrollHeight =
              mainContent.scrollHeight - mainContent.clientHeight
            const percentage =
              scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0
            progressBar.style.width = `${percentage}%`
          })

          // Section Tracking via IntersectionObserver
          const sections = mainContent.querySelectorAll("section[data-label]")
          const observerOptions = {
            root: mainContent,
            threshold: 0.6, // Fire when section takes up more than 60% of viewport frame
          }

          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && labelIndicator) {
                const label = entry.target.getAttribute("data-label")
                if (label) labelIndicator.textContent = label
              }
            })
          }, observerOptions)

          sections.forEach((section) => observer.observe(section))
        }

        // Parallax effect - only on desktop
        let ticking = false
        const parallaxLayers = document.querySelectorAll(".parallax-layer")

        function updateParallax() {
          const scrollY = window.scrollY
          parallaxLayers.forEach((layer: any) => {
            const speed = parseFloat(layer.getAttribute("data-speed") || "0.1")
            const yPos = -(scrollY * speed)
            layer.style.transform = `translate3d(0, ${yPos}px, 0)`
          })
          ticking = false
        }

        // Only enable parallax on non-mobile devices
        if (window.innerWidth > 640) {
          window.addEventListener(
            "scroll",
            () => {
              if (!ticking) {
                window.requestAnimationFrame(updateParallax)
                ticking = true
              }
            },
            { passive: true }
          )
          updateParallax()
        }

        // Floating particles animation
        const particles = document.querySelectorAll(".particle")
        particles.forEach((particle: any, index) => {
          const delay = index * 0.5
          const duration = 10 + Math.random() * 10
          const size = 2 + Math.random() * 3
          const startX = Math.random() * 100
          const startY = Math.random() * 100

          particle.style.cssText = `
            --delay: ${delay}s;
            --duration: ${duration}s;
            --size: ${size}px;
            --start-x: ${startX}%;
            --start-y: ${startY}%;
            animation: float ${duration}s ease-in-out infinite var(--delay);
          `
        })
      }

      setupInteractions()
    </script>
  </body>
</html>

<style is:global>
  .hided-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .hided-scrollbar::-webkit-scrollbar {
    display: none;
  }

  /* Parallax Background */
  .parallax-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
  }

  .parallax-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    will-change: transform;
  }

  .layer-1 {
    background:
      radial-gradient(
        ellipse at 20% 80%,
        rgba(120, 119, 198, 0.1) 0%,
        transparent 50%
      ),
      radial-gradient(
        ellipse at 80% 20%,
        rgba(255, 119, 198, 0.1) 0%,
        transparent 50%
      );
  }

  .layer-2 {
    background:
      radial-gradient(
        circle at 10% 30%,
        rgba(59, 130, 246, 0.08) 0%,
        transparent 30%
      ),
      radial-gradient(
        circle at 90% 70%,
        rgba(147, 51, 234, 0.08) 0%,
        transparent 30%
      );
  }

  /* Floating Particles */
  .particle {
    position: absolute;
    width: var(--size);
    height: var(--size);
    background: rgba(255, 255, 255, 0.05);
    border-radius: 50%;
    opacity: 0.6;
    filter: blur(1px);
    z-index: -1;
  }

  @keyframes float {
    0%,
    100% {
      transform: translate(var(--start-x), var(--start-y)) translateY(0)
        rotate(0deg);
      opacity: 0;
    }
    10%,
    90% {
      opacity: 0.6;
    }
    50% {
      transform: translate(var(--start-x), calc(var(--start-y) + 20vh))
        rotate(180deg);
    }
  }

  /* Mobile responsive adjustments */
  @media (max-width: 640px) {
    .parallax-container {
      display: none;
    }
  }
</style>
