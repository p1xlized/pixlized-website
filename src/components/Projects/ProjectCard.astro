---
interface Props {
  project: {
    id: number
    title: string
    date: string
    tag: "MOBILE" | "WEB" | "GAME"
    cover: string
    isVideo: boolean
    isPersonal: boolean
    stack?: string[]
  }
}

const { project } = Astro.props
---

<article
  class="group relative flex h-full w-full flex-col overflow-hidden rounded-lg border border-border bg-card shadow-sm transition-all hover:border-primary/40 hover:shadow-md"
>
  <div class="relative aspect-[16/10] w-full overflow-hidden bg-muted">
    <img
      src={project.cover}
      alt={project.title}
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      loading="lazy"
    />
    <div
      class="absolute top-2 right-2 left-2 flex items-center justify-between"
    >
      <span
        class="rounded-lg border border-background/80 bg-background/90 px-2 py-1 font-mono text-[8px] font-bold tracking-wider text-foreground uppercase backdrop-blur-sm"
      >
        {project.isPersonal ? "Personal" : "Work"}
      </span>
      <div class="flex items-center gap-1">
        {
          project.isVideo && (
            <span class="rounded-lg border border-red-600 bg-red-600/90 px-2 py-1 font-mono text-[8px] font-bold tracking-wider text-white uppercase backdrop-blur-sm">
              VIDEO
            </span>
          )
        }
        <span
          class="rounded-lg border border-primary/30 bg-background/90 px-2 py-1 font-mono text-[8px] font-bold tracking-wider text-primary uppercase backdrop-blur-sm"
        >
          {project.tag}
        </span>
      </div>
    </div>
  </div>

  <div class="flex flex-1 flex-col p-4">
    <div class="flex items-start justify-between gap-2">
      <h3
        class="line-clamp-2 flex-1 text-sm font-bold tracking-tight text-foreground transition-colors group-hover:text-primary"
      >
        {project.title}
      </h3>
      <span
        class="mt-1 flex-shrink-0 font-mono text-[8px] text-muted-foreground"
      >
        {project.date}
      </span>
    </div>
    {
      project.stack && project.stack.length > 0 && (
        <div class="mt-2 flex flex-wrap gap-1">
          {project.stack.slice(0, 3).map((tech) => (
            <span class="rounded border border-border bg-muted/40 px-2 py-0.5 font-mono text-[7px] text-muted-foreground">
              {tech}
            </span>
          ))}
          {project.stack.length > 3 && (
            <span class="rounded border border-border bg-muted/40 px-2 py-0.5 font-mono text-[7px] text-muted-foreground">
              +{project.stack.length - 3} more
            </span>
          )}
        </div>
      )
    }
  </div>

  <a
    href={`/projects/${project.id}`}
    class="absolute inset-0 z-10"
    aria-label={`View ${project.title} details`}></a>
</article>
