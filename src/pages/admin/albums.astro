---
import MainLayout from "@/layouts/main.astro"
import { getAlbums, getMusicTracks, getD1 } from "@/db/db"

// Get D1 instance from Cloudflare runtime locals
const d1 = getD1()

// Get all albums and tracks
const albums = await getAlbums(d1)
const tracks = await getMusicTracks(d1)

// Enrich albums with track counts and genres
const enrichedAlbums = albums.map((album) => {
  const albumTracks = tracks.filter((t) => t.albumId === album.id)
  const genres = [...new Set(albumTracks.map((t) => t.genre))].join(", ")
  return {
    ...album,
    trackCount: albumTracks.length,
    genres,
  }
})
---

<MainLayout>
  <section
    class="flex h-full w-full flex-col items-center justify-start px-4 py-12"
  >
    <div class="w-full max-w-4xl space-y-6">
      <!-- Header -->
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold tracking-tight">
            <span class="font-mono text-[hsl(var(--chart-2))]">💿</span> Albums
          </h1>
          <p class="mt-1 text-sm text-muted-foreground">
            Manage your music albums
          </p>
        </div>
        <div class="flex gap-2">
          <a
            href="/admin/dashboard"
            class="rounded-sm border border-border bg-secondary/50 px-3 py-1.5 font-mono text-xs font-bold tracking-wider uppercase transition-colors hover:bg-secondary/80"
          >
            Dashboard
          </a>
          <a
            href="/admin/albums/new"
            class="rounded-sm border border-[hsl(var(--chart-2))] bg-[hsl(var(--chart-2))] px-3 py-1.5 font-mono text-xs font-bold tracking-wider text-white uppercase transition-colors hover:bg-[hsl(var(--chart-2))]/90"
          >
            + New Album
          </a>
        </div>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
        <div class="rounded-sm border border-border bg-card p-4 text-center">
          <div class="text-2xl font-bold">{enrichedAlbums.length}</div>
          <div
            class="font-mono text-[10px] tracking-wider text-muted-foreground uppercase"
          >
            Total Albums
          </div>
        </div>
        <div class="rounded-sm border border-border bg-card p-4 text-center">
          <div class="text-2xl font-bold">
            {tracks.length}
          </div>
          <div
            class="font-mono text-[10px] tracking-wider text-muted-foreground uppercase"
          >
            Total Tracks
          </div>
        </div>
        <div class="rounded-sm border border-border bg-card p-4 text-center">
          <div class="text-2xl font-bold">
            {enrichedAlbums.filter((a) => a.cover).length}
          </div>
        </div>
        <div
          class="font-mono text-[10px] tracking-wider text-muted-foreground uppercase"
        >
          With Covers
        </div>
      </div>
      <div class="rounded-sm border border-border bg-card p-4 text-center">
        <div class="text-2xl font-bold">
          {enrichedAlbums.reduce((sum, a) => sum + (a.trackCount || 0), 0)}
        </div>
      </div>
      <div
        class="font-mono text-[10px] tracking-wider text-muted-foreground uppercase"
      >
        Avg Tracks/Album
      </div>
    </div>
  </section>

  <!-- Albums Grid -->
  <div class="space-y-4 rounded-sm border border-border bg-card p-6">
    <div class="flex items-center justify-between">
      <h2 class="font-mono text-sm font-bold tracking-tight uppercase">
        All Albums
      </h2>
      <span class="font-mono text-[10px] text-muted-foreground">
        [{enrichedAlbums.length} total]
      </span>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
      {
        enrichedAlbums.map((album) => (
          <div
            key={album.id}
            class="overflow-hidden rounded-sm border border-border/40 bg-secondary/30 transition-all hover:border-[hsl(var(--chart-2))]/40"
          >
            {album.cover ? (
              <img
                src={album.cover}
                alt={album.title}
                class="h-32 w-full object-cover"
              />
            ) : (
              <div class="flex h-32 w-full items-center justify-center bg-gradient-to-br from-muted to-secondary/50">
                <span class="font-mono text-2xl text-muted-foreground/60">
                  💿
                </span>
              </div>
            )}
            <div class="p-3">
              <div class="flex items-center justify-between">
                <div>
                  <h3 class="truncate text-sm font-semibold">{album.title}</h3>
                  <p class="mt-1 line-clamp-2 font-mono text-[10px] text-muted-foreground/80">
                    {album.description || "No description"}
                  </p>
                </div>
              </div>
              <div class="mt-3 flex items-center justify-between">
                <span class="rounded-xs border border-border/40 bg-secondary/80 px-2 font-mono text-[9px] text-muted-foreground">
                  {album.trackCount || 0} tracks
                </span>
                {album.genres && (
                  <span class="max-w-[120px] truncate rounded-xs border border-border/40 bg-secondary/80 px-2 font-mono text-[8px] text-muted-foreground">
                    {album.genres}
                  </span>
                )}
              </div>
              <div class="mt-2 flex gap-1">
                <a
                  href={`/admin/albums/${album.id}/edit`}
                  class="flex-1 rounded-xs border border-border/40 bg-secondary/50 py-1.5 text-center font-mono text-[9px] tracking-wider uppercase transition-colors hover:bg-secondary/80"
                >
                  Edit
                </a>
                <button
                  onclick={`confirmDelete(${album.id}, '${album.title}')`}
                  class="flex-1 rounded-xs border border-red-500/30 bg-red-500/10 py-1.5 text-center font-mono text-[9px] tracking-wider text-red-400/80 uppercase transition-colors hover:bg-red-500/20"
                >
                  Delete
                </button>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</MainLayout>

<!-- Delete Confirmation Modal -->
<div
  id="delete-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
>
  <div
    class="w-full max-w-md rounded-xl border border-border bg-background p-6 shadow-2xl"
  >
    <div class="mb-4 flex items-center justify-between">
      <h3 class="text-lg font-bold">Delete Album</h3>
      <button
        id="close-delete-modal"
        class="rounded-lg border border-input bg-background p-1.5 hover:bg-accent hover:text-accent-foreground"
        aria-label="Close"
      >
        <span class="font-mono text-xl">✕</span>
      </button>
    </div>
    <div class="space-y-4">
      <p id="delete-message" class="text-muted-foreground">
        Are you sure you want to delete this album?<br />
        <span class="text-[hsl(var(--chart-2))]"
          >All tracks in this album will NOT be deleted, but will be unassigned.</span
        >
      </p>
      <div class="flex justify-end gap-3">
        <button
          id="cancel-delete"
          class="rounded-sm border border-border bg-secondary/50 px-4 py-2 font-mono text-xs font-bold tracking-wider uppercase transition-colors hover:bg-secondary/80"
        >
          Cancel
        </button>
        <button
          id="confirm-delete-btn"
          class="rounded-sm border border-red-500/30 bg-red-500/20 px-4 py-2 font-mono text-xs font-bold tracking-wider text-red-400 uppercase transition-colors hover:bg-red-500/30"
        >
          Delete Album
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // Check auth
  document.addEventListener("DOMContentLoaded", () => {
    const isLoggedIn =
      sessionStorage.getItem("admin_logged_in") ||
      localStorage.getItem("admin_token")
    if (!isLoggedIn) {
      const adminSeed = import.meta.env.ADMIN_SEED
      if (!adminSeed) {
        console.error("ADMIN_SEED not configured")
        window.location.href = "/"
        return
      }
      window.location.href = `/secret/${adminSeed}/admin`
    }

    // Delete modal handling
    const deleteModal = document.getElementById("delete-modal")
    const closeBtn = document.getElementById("close-delete-modal")
    const cancelBtn = document.getElementById("cancel-delete")
    const confirmBtn = document.getElementById("confirm-delete-btn")
    const deleteMessage = document.getElementById("delete-message")

    let albumToDelete: number | null = null

    function confirmDelete(id: number, title: string) {
      albumToDelete = id
      if (deleteMessage)
        deleteMessage.innerHTML = `Delete <strong>"${title}"</strong>? This cannot be undone.`
      if (deleteModal) {
        deleteModal.classList.remove("hidden")
        deleteModal.classList.add("flex")
      }
    }

    function closeModal() {
      if (deleteModal) {
        deleteModal.classList.add("hidden")
        deleteModal.classList.remove("flex")
      }
      albumToDelete = null
    }

    if (closeBtn) closeBtn.onclick = closeModal
    if (cancelBtn) cancelBtn.onclick = closeModal

    if (confirmBtn) {
      confirmBtn.onclick = async () => {
        if (!albumToDelete) return

        try {
          const response = await fetch(
            `/api/admin/albums?id=${albumToDelete}`,
            {
              method: "DELETE",
              headers: {
                Authorization: `Bearer ${localStorage.getItem("admin_token")}`,
              },
            }
          )

          if (response.ok) {
            closeModal()
            window.location.reload()
          } else {
            alert("Failed to delete album")
          }
        } catch (err) {
          alert("Network error. Please try again.")
        }
      }
    }

    // Close modal on outside click
    if (deleteModal) {
      deleteModal.onclick = (e) => {
        if (e.target === deleteModal) closeModal()
      }
    }
  })
</script>
