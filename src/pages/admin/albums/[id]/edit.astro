---
import MainLayout from "@/layouts/main.astro"
import { getAlbums, getMusicTracks, getD1 } from "@/db/db"

// Get D1 instance from Cloudflare runtime locals
const d1 = getD1()

const { id } = Astro.params
const albums = await getAlbums(d1)
const album = albums.find((a) => a.id === Number(id))

if (!album) {
  return Astro.redirect("/admin/albums")
}

// Get tracks for this album
const allTracks = await getMusicTracks(d1)
const tracks = allTracks.filter((t) => t.albumId === album.id)
---

<MainLayout>
  <section
    class="flex h-full w-full flex-col items-center justify-start px-4 py-12"
  >
    <div class="w-full max-w-3xl space-y-6">
      <!-- Header -->
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold tracking-tight">
            <span class="font-mono text-[hsl(var(--chart-2))]">✏</span> Edit Album
          </h1>
          <p class="mt-1 text-sm text-muted-foreground">
            Edit album details and manage tracks
          </p>
        </div>
        <div class="flex gap-2">
          <a
            href="/admin/albums"
            class="rounded-sm border border-border bg-secondary/50 px-3 py-1.5 font-mono text-xs font-bold tracking-wider uppercase transition-colors hover:bg-secondary/80"
          >
            Back to Albums
          </a>
          <a
            href="/admin/music/new?albumId=${album.id}"
            class="rounded-sm border border-[hsl(var(--chart-2))] bg-[hsl(var(--chart-2))] px-3 py-1.5 font-mono text-xs font-bold tracking-wider text-white uppercase transition-colors hover:bg-[hsl(var(--chart-2))]/90"
          >
            + Add Track
          </a>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <!-- Edit Album Form -->
        <div class="space-y-4 rounded-sm border border-border bg-card p-6">
          <h2 class="font-mono text-sm font-bold tracking-tight uppercase">
            Album Details
          </h2>

          <form id="edit-album-form" class="space-y-4">
            <!-- Album Title -->
            <div class="space-y-1">
              <label
                class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
              >
                Album Title <span class="text-[hsl(var(--chart-2))]">*</span>
              </label>
              <input
                type="text"
                id="album-title"
                name="title"
                value={album.title}
                required
                class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-[hsl(var(--chart-2))] focus:ring-1 focus:ring-[hsl(var(--chart-2))]/20 focus:outline-none"
              />
            </div>

            <!-- Description -->
            <div class="space-y-1">
              <label
                class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
              >
                Description
              </label>
              <textarea
                id="album-description"
                name="description"
                rows="4"
                placeholder="Describe this album..."
                class="w-full resize-none rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-[hsl(var(--chart-2))] focus:ring-1 focus:ring-[hsl(var(--chart-2))]/20 focus:outline-none"
                >{album.description}</textarea
              >
            </div>

            <!-- Cover Image URL -->
            <div class="space-y-1">
              <label
                class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
              >
                Cover Image URL
              </label>
              <input
                type="text"
                id="album-cover"
                name="cover"
                value={album.cover || ""}
                placeholder="e.g., /assets/music/cover.jpg"
                class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-[hsl(var(--chart-2))] focus:ring-1 focus:ring-[hsl(var(--chart-2))]/20 focus:outline-none"
              />
              <p class="font-mono text-[9px] text-muted-foreground/60">
                Upload your cover image to /public/assets/music/ and reference
                it here
              </p>
            </div>

            <div class="flex gap-2 pt-2">
              <button
                type="submit"
                class="flex-1 rounded-sm bg-[hsl(var(--chart-2))] py-2 font-mono text-xs font-bold tracking-wider text-white uppercase shadow-sm transition-all hover:bg-[hsl(var(--chart-2))]/90"
              >
                Save Changes
              </button>
              <button
                type="reset"
                class="rounded-sm border border-border bg-secondary/50 px-4 py-2 font-mono text-xs font-bold tracking-wider uppercase transition-colors hover:bg-secondary/80"
              >
                Reset
              </button>
            </div>
          </form>

          <!-- Success Message -->
          <div
            id="success-message"
            class="hidden rounded-sm border border-green-500/30 bg-green-500/10 p-3 text-center"
          >
            <span class="font-mono text-green-400">✓</span>
            <span class="ml-2 font-mono text-[10px]"
              >Album updated successfully!</span
            >
          </div>

          <!-- Error Message -->
          <div
            id="error-message"
            class="hidden rounded-sm border border-red-500/30 bg-red-500/10 p-3 text-center"
          >
            <span class="font-mono text-red-400">✗</span>
            <span id="error-text" class="ml-2 font-mono text-[10px]"></span>
          </div>
        </div>

        <!-- Album Cover Preview -->
        <div class="space-y-4 rounded-sm border border-border bg-card p-6">
          <h2 class="font-mono text-sm font-bold tracking-tight uppercase">
            Cover Preview
          </h2>
          <div
            class="aspect-[16/9] rounded-sm border border-border/40 bg-secondary/30 p-6 text-center"
          >
            {
              album.cover ? (
                <img
                  src={album.cover}
                  alt="Album Cover Preview"
                  class="h-full w-full rounded-sm object-contain"
                />
              ) : (
                <div class="flex h-full flex-col items-center justify-center text-muted-foreground/60">
                  <span class="mb-2 font-mono text-4xl">💿</span>
                  <span class="font-mono text-xs tracking-wider uppercase">
                    No Cover Image
                  </span>
                </div>
              )
            }
          </div>
          <p class="text-center font-mono text-[9px] text-muted-foreground/50">
            Update the Cover Image URL to change the preview
          </p>
        </div>
      </div>

      <!-- Tracks in Album -->
      <div class="space-y-4 rounded-sm border border-border bg-card p-6">
        <div class="flex items-center justify-between">
          <h2 class="font-mono text-sm font-bold tracking-tight uppercase">
            Tracks in This Album
          </h2>
          <span class="font-mono text-[10px] text-muted-foreground">
            [{tracks.length} tracks]
          </span>
        </div>

        {
          tracks.length > 0 ? (
            <div class="space-y-2">
              {tracks.map((track, index) => (
                <div
                  key={track.id}
                  class="flex items-center justify-between rounded-sm border border-border/40 p-3 transition-colors hover:bg-secondary/50"
                >
                  <div class="flex min-w-0 flex-1 items-center gap-3">
                    <span class="w-6 text-right font-mono text-[10px] text-muted-foreground/60">
                      {index + 1}.
                    </span>
                    <div class="min-w-0 flex-1">
                      <div class="truncate text-sm font-semibold">
                        {track.title}
                      </div>
                      <div class="flex items-center gap-2 font-mono text-[10px] text-muted-foreground/80">
                        <span>{track.genre}</span>
                        <span>•</span>
                        <span>{track.duration}</span>
                        {track.bpm && (
                          <>
                            <span>•</span>
                            <span>{track.bpm} BPM</span>
                          </>
                        )}
                      </div>
                    </div>
                  </div>
                  <div class="flex gap-1">
                    <button
                      onclick={`confirmRemoveTrack(${track.id}, '${track.title}')`}
                      class="font-mono text-[10px] tracking-wider text-orange-400/80 uppercase hover:text-orange-400"
                    >
                      Remove
                    </button>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="py-8 text-center">
              <p class="font-mono text-[10px] text-muted-foreground/60">
                No tracks in this album yet.
              </p>
              <a
                href={`/admin/music/new?albumId=${album.id}`}
                class="mt-2 inline-block font-mono text-xs font-bold tracking-wider text-[hsl(var(--chart-2))] uppercase hover:underline"
              >
                + Add Track to This Album
              </a>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- Remove Track Confirmation Modal -->
  <div
    id="remove-track-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
  >
    <div
      class="w-full max-w-md rounded-xl border border-border bg-background p-6 shadow-2xl"
    >
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-lg font-bold">Remove Track from Album</h3>
        <button
          id="close-remove-track-modal"
          class="rounded-lg border border-input bg-background p-1.5 hover:bg-accent hover:text-accent-foreground"
          aria-label="Close"
        >
          <span class="font-mono text-xl">✕</span>
        </button>
      </div>
      <div class="space-y-4">
        <p id="remove-track-message" class="text-muted-foreground">
          Are you sure you want to remove this track from the album?<br />
          <span class="text-[hsl(var(--chart-2))]"
            >The track will NOT be deleted, just unassigned from this album.</span
          >
        </p>
        <div class="flex justify-end gap-3">
          <button
            id="cancel-remove-track"
            class="rounded-sm border border-border bg-secondary/50 px-4 py-2 font-mono text-xs font-bold tracking-wider uppercase transition-colors hover:bg-secondary/80"
          >
            Cancel
          </button>
          <button
            id="confirm-remove-track-btn"
            class="rounded-sm border border-orange-500/30 bg-orange-500/20 px-4 py-2 font-mono text-xs font-bold tracking-wider text-orange-400 uppercase transition-colors hover:bg-orange-500/30"
          >
            Remove from Album
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Delete Album Confirmation Modal -->
  <div
    id="delete-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
  >
    <div
      class="w-full max-w-md rounded-xl border border-border bg-background p-6 shadow-2xl"
    >
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-lg font-bold">Delete Album</h3>
        <button
          id="close-delete-modal"
          class="rounded-lg border border-input bg-background p-1.5 hover:bg-accent hover:text-accent-foreground"
          aria-label="Close"
        >
          <span class="font-mono text-xl">✕</span>
        </button>
      </div>
      <div class="space-y-4">
        <p id="delete-message" class="text-muted-foreground">
          Are you sure you want to delete this album?<br />
          <span class="text-[hsl(var(--chart-2))]"
            >All tracks will be unassigned but NOT deleted.</span
          >
        </p>
        <div class="flex justify-end gap-3">
          <button
            id="cancel-delete"
            class="rounded-sm border border-border bg-secondary/50 px-4 py-2 font-mono text-xs font-bold tracking-wider uppercase transition-colors hover:bg-secondary/80"
          >
            Cancel
          </button>
          <button
            id="confirm-delete-btn"
            class="rounded-sm border border-red-500/30 bg-red-500/20 px-4 py-2 font-mono text-xs font-bold tracking-wider text-red-400 uppercase transition-colors hover:bg-red-500/30"
          >
            Delete Album
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Check auth
    document.addEventListener("DOMContentLoaded", () => {
      const isLoggedIn =
        sessionStorage.getItem("admin_logged_in") ||
        localStorage.getItem("admin_token")
      if (!isLoggedIn) {
        const adminSeed = import.meta.env.ADMIN_SEED
        window.location.href = `/secret/${adminSeed}/admin`
      }

      // Edit form handling
      const form = document.getElementById("edit-album-form")
      const coverInput = document.getElementById(
        "album-cover"
      ) as HTMLInputElement
      const preview = document.querySelector(
        ".rounded-sm.border.border-border\/40.bg-secondary\/30"
      )
      const successMsg = document.getElementById("success-message")
      const errorMsg = document.getElementById("error-message")
      const errorText = document.getElementById("error-text")

      // Update preview when cover URL changes
      if (coverInput && preview) {
        coverInput.addEventListener("input", () => {
          const url = coverInput.value.trim()
          if (url) {
            preview.innerHTML = `<img src="${url}" alt="Album Cover Preview" class="h-full w-full object-contain rounded-sm" />`
          } else {
            preview.innerHTML = `
              <div class="h-full flex flex-col items-center justify-center text-muted-foreground/60">
                <span class="font-mono text-4xl mb-2">💿</span>
                <span class="font-mono text-xs uppercase tracking-wider">No Cover Image</span>
              </div>
            `
          }
        })
      }

      form?.addEventListener("submit", async (e) => {
        e.preventDefault()

        const title =
          (document.getElementById("album-title") as HTMLInputElement)?.value ||
          ""
        const description =
          (document.getElementById("album-description") as HTMLTextAreaElement)
            ?.value || ""
        const cover =
          (document.getElementById("album-cover") as HTMLInputElement)?.value ||
          ""

        try {
          const response = await fetch("/api/admin/albums", {
            method: "PUT",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${localStorage.getItem("admin_token")}`,
            },
            body: JSON.stringify({
              id: id,
              title,
              description,
              cover,
            }),
          })

          if (response.ok) {
            successMsg.classList.remove("hidden")
            errorMsg.classList.add("hidden")
            setTimeout(() => successMsg.classList.add("hidden"), 3000)
          } else {
            const data = await response.json()
            errorText.textContent = data.error || "Failed to update album"
            errorMsg.classList.remove("hidden")
            successMsg.classList.add("hidden")
            setTimeout(() => errorMsg.classList.add("hidden"), 3000)
          }
        } catch (err) {
          errorText.textContent = "Network error. Please try again."
          errorMsg.classList.remove("hidden")
          successMsg.classList.add("hidden")
          setTimeout(() => errorMsg.classList.add("hidden"), 3000)
        }
      })

      // Remove track from album modal
      const removeTrackModal = document.getElementById("remove-track-modal")
      const closeRemoveTrackBtn = document.getElementById(
        "close-remove-track-modal"
      )
      const cancelRemoveTrackBtn = document.getElementById(
        "cancel-remove-track"
      )
      const confirmRemoveTrackBtn = document.getElementById(
        "confirm-remove-track-btn"
      )
      const removeTrackMessage = document.getElementById("remove-track-message")

      let trackToRemove: number | null = null

      function confirmRemoveTrack(id: number, title: string) {
        trackToRemove = id
        if (removeTrackMessage)
          removeTrackMessage.innerHTML = `Remove <strong>"${title}"</strong> from this album?`
        if (removeTrackModal) {
          removeTrackModal.classList.remove("hidden")
          removeTrackModal.classList.add("flex")
        }
      }

      function closeRemoveTrackModal() {
        if (removeTrackModal) {
          removeTrackModal.classList.add("hidden")
          removeTrackModal.classList.remove("flex")
        }
        trackToRemove = null
      }

      if (closeRemoveTrackBtn)
        closeRemoveTrackBtn.onclick = closeRemoveTrackModal
      if (cancelRemoveTrackBtn)
        cancelRemoveTrackBtn.onclick = closeRemoveTrackModal

      if (confirmRemoveTrackBtn) {
        confirmRemoveTrackBtn.onclick = async () => {
          if (!trackToRemove) return

          try {
            // Set albumId to 1 (default album) instead of deleting
            const response = await fetch("/api/admin/music", {
              method: "PUT",
              headers: {
                "Content-Type": "application/json",
                Authorization: `Bearer ${localStorage.getItem("admin_token")}`,
              },
              body: JSON.stringify({
                id: trackToRemove,
                albumId: 1,
              }),
            })

            if (response.ok) {
              closeRemoveTrackModal()
              window.location.reload()
            } else {
              alert("Failed to remove track from album")
            }
          } catch (err) {
            alert("Network error. Please try again.")
          }
        }
      }

      // Close modal on outside click
      if (removeTrackModal) {
        removeTrackModal.onclick = (e) => {
          if (e.target === removeTrackModal) closeRemoveTrackModal()
        }
      }

      // Check for URL parameter to pre-select album
      const urlParams = new URLSearchParams(window.location.search)
      const albumIdParam = urlParams.get("albumId")
    })
  </script>
</MainLayout>
