---
// ShowcaseSection.astro - Second section with 2 best projects + toolkit
import { db } from "@/db/db"
import ToolkitGrid from "./ToolkitGrid"
import { memoizedQuery } from "@/utils/memoize"

// Memoized query for 2 random featured projects
const getFeaturedProjects = () => {
  const statement = db.prepare(`
    SELECT * FROM projects
    WHERE isFeatured = 1
    ORDER BY RANDOM()
    LIMIT 2
  `)
  const rows = statement.all() as any[]

  return rows.map((row) => ({
    title: row.title,
    description: row.description,
    image: row.cover,
    tags: JSON.parse(row.stack || "[]"),
    link: `/projects/${row.id}`,
  }))
}

// Memoize the query - will only run once per deployment
const projects = memoizedQuery("showcase_projects", getFeaturedProjects)

// Fallback projects if DB is empty
const fallbackProjects = [
  {
    title: "Pixlized Portfolio",
    description:
      "A modern, fast, and beautiful portfolio website built with Astro and Tailwind CSS.",
    image: "https://picsum.photos/seed/portfolio/800/450",
    tags: ["Astro", "Tailwind", "TypeScript"],
    link: "/projects/1",
  },
  {
    title: "Creative Engine",
    description:
      "A powerful creative toolkit for developers and designers to build amazing experiences.",
    image: "https://picsum.photos/seed/engine/800/450",
    tags: ["React", "Next.js", "Godot"],
    link: "/projects/2",
  },
]

const displayProjects = projects.length > 0 ? projects : fallbackProjects
---

<section
  data-label="Showcase"
  id="showcase"
  class="flex h-full w-full shrink-0 snap-start flex-col items-center justify-between py-6"
>
  <div
    class="hided-scrollbar flex max-h-[85vh] w-full max-w-2xl flex-col items-center space-y-8 overflow-y-auto px-4 text-center"
  >
    <!-- Best Projects -->
    <div class="w-full space-y-4">
      <div
        class="flex flex-col items-center space-y-0.5 border-b border-border pb-2"
      >
        <h2
          class="font-mono text-sm font-bold tracking-tight text-primary uppercase"
        >
          Featured Projects
        </h2>
        <span class="font-mono text-[10px] text-muted-foreground/60"
          >My Best Work</span
        >
      </div>
      <div class="grid gap-6 text-left sm:grid-cols-2">
        {
          displayProjects.map((project) => (
            <div class="group relative flex flex-col overflow-hidden rounded-lg border border-border bg-card shadow-sm transition-all hover:border-primary/40">
              <div class="relative aspect-[16/10] w-full overflow-hidden border-b border-border/60 bg-muted">
                <img
                  src={project.image}
                  alt={project.title}
                  class="h-full w-full object-cover brightness-[92%] grayscale-[20%] transition-transform duration-500 group-hover:scale-[1.01] group-hover:brightness-100 group-hover:grayscale-0"
                />
              </div>
              <div class="flex flex-1 flex-col justify-between space-y-3 p-4">
                <div class="space-y-1">
                  <h3 class="text-sm font-bold tracking-tight transition-colors group-hover:text-primary">
                    {project.title}
                  </h3>
                  <p class="line-clamp-2 text-xs leading-normal text-muted-foreground">
                    {project.description}
                  </p>
                </div>
                <div class="flex flex-wrap gap-1">
                  {project.tags.map((tag: string) => (
                    <span class="inline-flex items-center rounded-sm border border-border/60 bg-secondary px-1.5 py-0.5 font-mono text-[9px] font-medium text-secondary-foreground">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              <a
                href={project.link}
                class="absolute inset-0 z-10"
                aria-label={`View ${project.title}`}
              />
            </div>
          ))
        }
      </div>
    </div>

    <!-- Toolkit -->
    <div class="w-full space-y-4">
      <div
        class="flex flex-col items-center space-y-0.5 border-b border-border pb-2"
      >
        <h2
          class="font-mono text-sm font-bold tracking-tight text-primary uppercase"
        >
          Toolkit & Skills
        </h2>
        <span class="font-mono text-[10px] text-muted-foreground/60"
          >Technologies & Frameworks</span
        >
      </div>
      <!-- React component for toolkit -->
      <ToolkitGrid client:load />
    </div>
  </div>

  <!-- Scroll Anchor to Section 3 -->
  <div class="flex w-full justify-center pt-2">
    <a
      href="#contact"
      class="inline-flex flex-col items-center gap-1 font-mono text-[10px] tracking-widest text-muted-foreground/50 uppercase transition-colors duration-200 hover:text-primary"
    >
      <span>Contact Me</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2.5"
        stroke="currentColor"
        class="h-3.5 w-3.5 animate-bounce"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
      </svg>
    </a>
  </div>
</section>

<style is:global>
  @media (max-width: 640px) {
    .grid.grid-cols-5 {
      grid-template-columns: repeat(5, 1fr);
    }
    .grid.grid-cols-10 {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  @media (min-width: 641px) and (max-width: 768px) {
    .grid.grid-cols-10 {
      grid-template-columns: repeat(10, 1fr);
    }
  }
</style>
