---
import MainLayout from "@/layouts/main.astro"
import { getProjects, getD1 } from "@/db/db"

// Get D1 instance from Cloudflare runtime locals
const d1 = getD1()

// Get all projects
const projects = await getProjects(d1)
---

<MainLayout>
  <section
    class="flex h-full w-full flex-col items-center justify-start px-4 py-12"
  >
    <div class="w-full max-w-4xl space-y-6">
      <!-- Header -->
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold tracking-tight">
            <span class="font-mono text-[hsl(var(--chart-1))]">📁</span> Projects
          </h1>
          <p class="mt-1 text-sm text-muted-foreground">Manage your projects</p>
        </div>
        <div class="flex gap-2">
          <a
            href="/admin/dashboard"
            class="rounded-sm border border-border bg-secondary/50 px-3 py-1.5 font-mono text-xs font-bold tracking-wider uppercase transition-colors hover:bg-secondary/80"
          >
            Dashboard
          </a>
          <a
            href="/admin/projects/new"
            class="rounded-sm border border-[hsl(var(--chart-1))] bg-[hsl(var(--chart-1))] px-3 py-1.5 font-mono text-xs font-bold tracking-wider text-white uppercase transition-colors hover:bg-[hsl(var(--chart-1))]/90"
          >
            + New Project
          </a>
        </div>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
        <div class="rounded-sm border border-border bg-card p-4 text-center">
          <div class="text-2xl font-bold">{projects.length}</div>
          <div
            class="font-mono text-[10px] tracking-wider text-muted-foreground uppercase"
          >
            Total Projects
          </div>
        </div>
        <div class="rounded-sm border border-border bg-card p-4 text-center">
          <div class="text-2xl font-bold">
            {
              db
                .prepare(
                  "SELECT COUNT(*) as count FROM projects WHERE isFeatured = 1"
                )
                .get().count
            }
          </div>
          <div
            class="font-mono text-[10px] tracking-wider text-muted-foreground uppercase"
          >
            Featured
          </div>
        </div>
        <div class="rounded-sm border border-border bg-card p-4 text-center">
          <div class="text-2xl font-bold">
            {
              db
                .prepare(
                  "SELECT COUNT(*) as count FROM projects WHERE isPersonal = 1"
                )
                .get().count
            }
          </div>
          <div
            class="font-mono text-[10px] tracking-wider text-muted-foreground uppercase"
          >
            Personal
          </div>
        </div>
        <div class="rounded-sm border border-border bg-card p-4 text-center">
          <div class="text-2xl font-bold">
            {
              db
                .prepare(
                  "SELECT COUNT(DISTINCT tag) as count FROM projects WHERE tag IS NOT NULL"
                )
                .get().count || 0
            }
          </div>
          <div
            class="font-mono text-[10px] tracking-wider text-muted-foreground uppercase"
          >
            Tags
          </div>
        </div>
      </div>

      <!-- Projects Grid -->
      <div class="space-y-4 rounded-sm border border-border bg-card p-6">
        <div class="flex items-center justify-between">
          <h2 class="font-mono text-sm font-bold tracking-tight uppercase">
            All Projects
          </h2>
          <span class="font-mono text-[10px] text-muted-foreground">
            [{projects.length} total]
          </span>
        </div>

        {
          projects.length === 0 ? (
            <div class="flex h-32 items-center justify-center text-muted-foreground">
              <p>No projects found. Create your first project!</p>
            </div>
          ) : (
            <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
              {projects.map((project) => (
                <div
                  key={project.id}
                  class="overflow-hidden rounded-sm border border-border/40 bg-secondary/30 transition-all hover:border-[hsl(var(--chart-1))]/40"
                >
                  {project.cover ? (
                    <img
                      src={project.cover}
                      alt={project.title}
                      class="h-32 w-full object-cover"
                    />
                  ) : (
                    <div class="flex h-32 w-full items-center justify-center bg-secondary/40">
                      <span class="font-mono text-xs text-muted-foreground">
                        No Cover
                      </span>
                    </div>
                  )}
                  <div class="p-3">
                    <div class="flex items-center justify-between">
                      <h3 class="truncate text-sm font-bold">
                        {project.title}
                      </h3>
                      <span class="font-mono text-[10px] text-muted-foreground">
                        {project.tag}
                      </span>
                    </div>
                    <p class="mt-1 truncate font-mono text-[10px] text-muted-foreground">
                      {project.tech}
                    </p>
                    <div class="mt-2 flex gap-2">
                      <a
                        href={`/admin/projects/${project.id}/edit`}
                        class="flex-1 rounded-sm border border-border bg-secondary/50 px-2 py-1 text-center font-mono text-[10px] tracking-wider uppercase transition-colors hover:bg-secondary/80"
                      >
                        Edit
                      </a>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </section>

  <script>
    // Check auth on page load
    document.addEventListener("DOMContentLoaded", () => {
      const isLoggedIn =
        sessionStorage.getItem("admin_logged_in") ||
        localStorage.getItem("admin_token")
      if (!isLoggedIn) {
        const adminSeed = import.meta.env.ADMIN_SEED
        window.location.href = `/secret/${adminSeed}/admin`
      }
    })
  </script>
</MainLayout>
