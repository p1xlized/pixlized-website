---
import "@/styles/global.css"
import { ClientRouter } from "astro:transitions"
---

<html lang="en" class="h-full overflow-hidden select-none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Astro App</title>
    <ClientRouter />

    <script is:inline>
      const getThemePreference = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme")
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light"
      }
      const isDark = getThemePreference() === "dark"
      document.documentElement.classList[isDark ? "add" : "remove"]("dark")

      if (typeof localStorage !== "undefined") {
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains("dark")
          localStorage.setItem("theme", isDark ? "dark" : "light")
        })
        observer.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["class"],
        })
      }
    </script>
  </head>

  <body
    class="mx-auto flex h-full max-w-3xl flex-col overflow-hidden bg-background px-6 text-foreground antialiased"
  >
    <!-- 1. FIXED NAVIGATION BAR -->
    <header
      class="relative z-50 flex h-20 shrink-0 flex-col justify-center border-b border-border bg-background py-4"
    >
      <div class="flex w-full items-center justify-between">
        <div class="flex flex-col">
          <a
            href="/"
            class="font-bold tracking-tight text-primary transition-colors hover:text-muted-foreground"
          >
            @pixlized
          </a>
          <!-- DYNAMIC SECTION LABEL STATE -->
          <span
            id="current-section-label"
            class="font-mono text-[10px] tracking-widest text-muted-foreground/70 uppercase transition-all duration-300"
          >
            Overview
          </span>
        </div>

        <nav class="flex items-center gap-6">
          <a
            href="#projects"
            class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
          >
            Projects
          </a>
          <a
            href="#blog"
            class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
          >
            Blog
          </a>

          <button
            id="theme-toggle"
            class="rounded-md border border-input bg-background p-2 transition-colors hover:bg-accent hover:text-accent-foreground"
            aria-label="Toggle Theme"
          >
            <svg
              id="theme-toggle-sun"
              class="hidden h-[1.2rem] w-[1.2rem] dark:block"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 3v2.25m0 13.5V21m8.966-8.966h-2.25m-13.5 0h-2.25m15.364-6.364l-1.591 1.591M6.343 17.657l-1.591 1.591m15.364 0l-1.591-1.591M6.343 6.343L4.752 4.752M12 7.5a4.5 4.5 0 100 9 4.5 4.5 0 000-9z"
              ></path>
            </svg>
            <svg
              id="theme-toggle-moon"
              class="block h-[1.2rem] w-[1.2rem] dark:hidden"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
              ></path>
            </svg>
          </button>
        </nav>
      </div>

      <!-- SCROLL PROGRESS BAR INDICATOR -->
      <div
        class="absolute bottom-0 left-0 h-[2px] w-0 bg-primary transition-all duration-75"
        id="scroll-progress"
      >
      </div>
    </header>

    <!-- 2. SCROLLABLE SNAP CONTAINER -->
    <main
      id="scrollable-content"
      class="hided-scrollbar flex-1 snap-y snap-mandatory overflow-y-auto scroll-smooth"
    >
      <slot />
    </main>

    <!-- 3. FIXED FOOTER -->
    <footer
      class="z-50 flex shrink-0 justify-between border-t border-border bg-background py-4 text-xs text-muted-foreground"
    >
      <p>© 2026 Your Name. Built with Astro & Shadcn.</p>
      <div class="flex gap-4">
        <a href="https://github.com" class="transition hover:text-foreground"
          >GitHub</a
        >
        <a href="https://twitter.com" class="transition hover:text-foreground"
          >Twitter</a
        >
      </div>
    </footer>

    <script>
      const setupInteractions = () => {
        // Theme Toggle
        document
          .getElementById("theme-toggle")
          ?.addEventListener("click", () => {
            const element = document.documentElement
            element.classList.toggle("dark")
            localStorage.setItem(
              "theme",
              element.classList.contains("dark") ? "dark" : "light"
            )
          })

        const mainContent = document.getElementById("scrollable-content")
        const progressBar = document.getElementById("scroll-progress")
        const labelIndicator = document.getElementById("current-section-label")

        if (mainContent && progressBar) {
          // Scroll Progress calculation
          mainContent.addEventListener("scroll", () => {
            const scrollTop = mainContent.scrollTop
            const scrollHeight =
              mainContent.scrollHeight - mainContent.clientHeight
            const percentage =
              scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0
            progressBar.style.width = `${percentage}%`
          })

          // Section Tracking via IntersectionObserver
          const sections = mainContent.querySelectorAll("section[data-label]")
          const observerOptions = {
            root: mainContent,
            threshold: 0.6, // Fire when section takes up more than 60% of viewport frame
          }

          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && labelIndicator) {
                const label = entry.target.getAttribute("data-label")
                if (label) labelIndicator.textContent = label
              }
            })
          }, observerOptions)

          sections.forEach((section) => observer.observe(section))
        }
      }

      setupInteractions()
      document.addEventListener("astro:after-swap", setupInteractions)
    </script>
  </body>
</html>

<style is:global>
  .hided-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .hided-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>
