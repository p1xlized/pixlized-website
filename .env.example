# Environment Variables for Pixlized Website
# Copy this file to .env and fill in the values

# ==========================================
# REQUIRED VARIABLES
# ==========================================

# Admin Access Seed
# This is used to hide the admin route behind a secret path
# Access admin at: /<ADMIN_SEED>/admin
# Change this to a unique value for security
ADMIN_SEED="pixlized-secret-2026"

# Admin Credentials
# Username for admin login
ADMIN_USER="admin"

# Password for admin login (plain text - will be hashed internally)
ADMIN_PASS="your-secure-password"

# Formspree Endpoint for Contact Form
# Get your endpoint from: https://formspree.io
# This is used for the contact form submissions
FORMSPREE_ENDPOINT="https://formspree.io/f/your-form-id"

# ==========================================
# OPTIONAL VARIABLES
# ==========================================

# Pre-computed password hash (alternative to ADMIN_PASS)
# If you want to use a pre-hashed password instead of plain text
# Generate with: echo -n "username:password" | sha256sum
ADMIN_PASSWORD_HASH=""

# ==========================================
# CLOUDFLARE SPECIFIC (for deployment)
# ==========================================

# Set this when building for Cloudflare
ASTRO_ADAPTER="cloudflare"

# Cloudflare KV Namespace ID (for persistent storage)
KV_NAMESPACE_ID="your-kv-namespace-id"

# Cloudflare R2 Bucket (for asset storage)
CF_R2_BUCKET="your-r2-binding"
CF_R2_PUBLIC="https://your-account.r2.cloudflarestorage.com/public"

# Cloudflare D1 Database (SQLite compatible)
CF_D1_DB="your-d1-binding"

# ==========================================
# DEVELOPMENT
# ==========================================

# Run with: pnpm dev
# Or for Cloudflare: ASTRO_ADAPTER=cloudflare pnpm dev

# ==========================================
# NOTES
# ==========================================
# - ADMIN_SEED: Change this to a unique, hard-to-guess value
# - ADMIN_USER/ADMIN_PASS: Set these for admin panel access
# - FORMSPREE_ENDPOINT: Required for contact form to work
# - All other variables are optional and for Cloudflare deployment
