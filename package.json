{
  "name": "astro-app",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:cloudflare": "ASTRO_ADAPTER=cloudflare astro build",
    "preview": "astro preview",
    "preview:cloudflare": "ASTRO_ADAPTER=cloudflare astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,astro}\"",
    "typecheck": "astro check",
    "deploy:cloudflare": "wrangler deploy",
    "deploy:cloudflare:dev": "wrangler deploy --env development",
    "tail:cloudflare": "wrangler tail --format json",
    "generate-types": "wrangler types"
  },
  "pnpm": {
    "overrides": {}
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.2.0",
    "@astrojs/react": "^4.2.0",
    "@base-ui/react": "^1.0.0-alpha.1",
    "@fontsource-variable/geist": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "@thesvg/react": "^3.3.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "astro": "^5.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.20.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "prettier": "^3.5.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "wrangler": "^3.107.0"
  }
}
