---
import MainLayout from "@/layouts/main.astro"
import { db } from "@/db/db"

// Get all albums with their track counts
const albums = db.prepare(`
  SELECT a.*,
         COUNT(mt.id) as trackCount,
         GROUP_CONCAT(mt.genre, ', ') as genres
  FROM albums a
  LEFT JOIN music_tracks mt ON a.id = mt.albumId
  GROUP BY a.id
  ORDER BY a.createdAt DESC
`).all() as any[]
---

<MainLayout>
  <section class="flex h-full w-full flex-col items-center justify-start py-12 px-4">
    <div class="w-full max-w-4xl space-y-6">
      <!-- Header -->
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold tracking-tight">
            <span class="font-mono text-[hsl(var(--chart-2))]">💿</span> Albums
          </h1>
          <p class="mt-1 text-sm text-muted-foreground">
            Manage your music albums
          </p>
        </div>
        <div class="flex gap-2">
          <a
            href="/admin/dashboard"
            class="rounded-sm border border-border bg-secondary/50 px-3 py-1.5 font-mono text-xs font-bold tracking-wider uppercase transition-colors hover:bg-secondary/80"
          >
            Dashboard
          </a>
          <a
            href="/admin/albums/new"
            class="rounded-sm border border-[hsl(var(--chart-2))] bg-[hsl(var(--chart-2))] px-3 py-1.5 font-mono text-xs font-bold tracking-wider uppercase transition-colors hover:bg-[hsl(var(--chart-2))]/90 text-white"
          >
            + New Album
          </a>
        </div>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="rounded-sm border border-border bg-card p-4 text-center">
          <div class="text-2xl font-bold">{albums.length}</div>
          <div class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
            Total Albums
          </div>
        </div>
        <div class="rounded-sm border border-border bg-card p-4 text-center">
          <div class="text-2xl font-bold">
            {db.prepare("SELECT COUNT(*) as count FROM music_tracks").get().count}
          </div>
          <div class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
            Total Tracks
          </div>
        </div>
        <div class="rounded-sm border border-border bg-card p-4 text-center">
          <div class="text-2xl font-bold">
            {db.prepare("SELECT COUNT(*) as count FROM albums WHERE cover IS NOT NULL").get().count}
          </div>
          <div class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
            With Covers
          </div>
        </div>
        <div class="rounded-sm border border-border bg-card p-4 text-center">
          <div class="text-2xl font-bold">
            {db.prepare("SELECT SUM(trackCount) as count FROM (SELECT COUNT(*) as trackCount FROM music_tracks GROUP BY albumId)").get().count || 0}
          </div>
          <div class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
            Avg Tracks/Album
          </div>
        </div>
      </div>

      <!-- Albums Grid -->
      <div class="rounded-sm border border-border bg-card p-6 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="font-mono text-sm font-bold tracking-tight uppercase">
            All Albums
          </h2>
          <span class="font-mono text-[10px] text-muted-foreground">
            [{albums.length} total]
          </span>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
          {albums.map((album) => (
            <div
              key={album.id}
              class="rounded-sm border border-border/40 bg-secondary/30 overflow-hidden transition-all hover:border-[hsl(var(--chart-2))]/40"
            >
              {album.cover ? (
                <img
                  src={album.cover}
                  alt={album.title}
                  class="h-32 w-full object-cover"
                />
              ) : (
                <div class="h-32 w-full bg-gradient-to-br from-muted to-secondary/50 flex items-center justify-center">
                  <span class="font-mono text-2xl text-muted-foreground/60">💿</span>
                </div>
              )}
              <div class="p-3">
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="font-semibold text-sm truncate">{album.title}</h3>
                    <p class="font-mono text-[10px] text-muted-foreground/80 line-clamp-2 mt-1">
                      {album.description || 'No description'}
                    </p>
                  </div>
                </div>
                <div class="flex items-center justify-between mt-3">
                  <span class="rounded-xs border border-border/40 bg-secondary/80 px-2 font-mono text-[9px] text-muted-foreground">
                    {album.trackCount || 0} tracks
                  </span>
                  {album.genres && (
                    <span class="rounded-xs border border-border/40 bg-secondary/80 px-2 font-mono text-[8px] text-muted-foreground truncate max-w-[120px]">
                      {album.genres}
                    </span>
                  )}
                </div>
                <div class="flex gap-1 mt-2">
                  <a
                    href={`/admin/albums/${album.id}/edit`}
                    class="flex-1 rounded-xs border border-border/40 bg-secondary/50 py-1.5 font-mono text-[9px] text-center uppercase tracking-wider transition-colors hover:bg-secondary/80"
                  >
                    Edit
                  </a>
                  <button
                    onclick={`confirmDelete(${album.id}, '${album.title}')`}
                    class="flex-1 rounded-xs border border-red-500/30 bg-red-500/10 py-1.5 font-mono text-[9px] text-center uppercase tracking-wider transition-colors hover:bg-red-500/20 text-red-400/80"
                  >
                    Delete
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Delete Confirmation Modal -->
  <div
    id="delete-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm p-4"
  >
    <div class="rounded-xl border border-border bg-background p-6 shadow-2xl max-w-md w-full">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold">Delete Album</h3>
        <button
          id="close-delete-modal"
          class="rounded-lg border border-input bg-background p-1.5 hover:bg-accent hover:text-accent-foreground"
          aria-label="Close"
        >
          <span class="font-mono text-xl">✕</span>
        </button>
      </div>
      <div class="space-y-4">
        <p id="delete-message" class="text-muted-foreground">
          Are you sure you want to delete this album?<br />
          <span class="text-[hsl(var(--chart-2))]">All tracks in this album will NOT be deleted, but will be unassigned.</span>
        </p>
        <div class="flex gap-3 justify-end">
          <button
            id="cancel-delete"
            class="rounded-sm border border-border bg-secondary/50 px-4 py-2 font-mono text-xs font-bold tracking-wider uppercase transition-colors hover:bg-secondary/80"
          >
            Cancel
          </button>
          <button
            id="confirm-delete-btn"
            class="rounded-sm bg-red-500/20 border border-red-500/30 px-4 py-2 font-mono text-xs font-bold tracking-wider uppercase transition-colors hover:bg-red-500/30 text-red-400"
          >
            Delete Album
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Check auth
    document.addEventListener('DOMContentLoaded', () => {
      const isLoggedIn = sessionStorage.getItem('admin_logged_in') ||
                        localStorage.getItem('admin_token')
      if (!isLoggedIn) {
        window.location.href = '/admin'
      }

      // Delete modal handling
      const deleteModal = document.getElementById('delete-modal')
      const closeBtn = document.getElementById('close-delete-modal')
      const cancelBtn = document.getElementById('cancel-delete')
      const confirmBtn = document.getElementById('confirm-delete-btn')
      const deleteMessage = document.getElementById('delete-message')

      let albumToDelete: number | null = null

      function confirmDelete(id: number, title: string) {
        albumToDelete = id
        if (deleteMessage) deleteMessage.innerHTML = `Delete <strong>"${title}"</strong>? This cannot be undone.`
        if (deleteModal) {
          deleteModal.classList.remove('hidden')
          deleteModal.classList.add('flex')
        }
      }

      function closeModal() {
        if (deleteModal) {
          deleteModal.classList.add('hidden')
          deleteModal.classList.remove('flex')
        }
        albumToDelete = null
      }

      if (closeBtn) closeBtn.onclick = closeModal
      if (cancelBtn) cancelBtn.onclick = closeModal

      if (confirmBtn) {
        confirmBtn.onclick = async () => {
          if (!albumToDelete) return

          try {
            const response = await fetch(`/api/admin/albums?id=${albumToDelete}`, {
              method: 'DELETE',
              headers: {
                'Authorization': `Bearer ${localStorage.getItem('admin_token')}`
              }
            })

            if (response.ok) {
              closeModal()
              window.location.reload()
            } else {
              alert('Failed to delete album')
            }
          } catch (err) {
            alert('Network error. Please try again.')
          }
        }
      }

      // Close modal on outside click
      if (deleteModal) {
        deleteModal.onclick = (e) => {
          if (e.target === deleteModal) closeModal()
        }
      }
    })
  </script>
</MainLayout>
