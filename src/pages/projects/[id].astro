---
import MainLayout from "../../layouts/main.astro"
import { getProjects, getD1 } from "../../db/db"
import ImageCarousel from "../../components/Projects/ImageCarousel"
import "@/styles/global.css"

// Get D1 instance from Cloudflare runtime locals
const d1 = getD1()

const { id } = Astro.params as { id: string }

const allProjects = await getProjects(d1)
const project = allProjects.find((p) => p.id === Number(id))

if (!project) {
  return Response.redirect(new URL("/projects", Astro.request.url), 302)
}

const allProjectsSimple = allProjects.map((p) => ({
  id: p.id,
  title: p.title,
}))

const currentIndex = allProjects.findIndex((p) => p.id === project.id)
const prevProject = currentIndex > 0 ? allProjects[currentIndex - 1] : null
const nextProject =
  currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : null

function getYouTubeEmbedUrl(url: string): string {
  if (!url) return ""
  const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/
  const match = url.match(regExp)
  if (match && match[2].length === 11) {
    return `https://www.youtube.com/embed/${match[2]}?rel=0&modestbranding=1`
  }
  if (url.includes("youtube.com/embed/")) {
    return url.includes("?") ? url : `${url}?rel=0&modestbranding=1`
  }
  return url
}

const videoEmbedUrl: string = project.videoUrl
  ? getYouTubeEmbedUrl(project.videoUrl)
  : ""
const hasVideo: boolean = project.isVideo && !!videoEmbedUrl
const hasImages: boolean = project.imgs && project.imgs.length > 0
const images: string[] = project.imgs || []
---

<MainLayout>
  <section
    data-label="Project Details"
    class="flex min-h-[calc(100vh-140px)] w-full flex-col"
  >
    <div class="w-full max-w-7xl flex-1 px-4 py-4 sm:px-6 lg:px-8">
      <!-- HEADER & NAVIGATION & LINKS -->
      <div class="mb-6 w-full">
        <div
          class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
        >
          <a
            href="/projects"
            class="group flex items-center gap-1.5 font-mono text-[10px] text-muted-foreground transition-colors hover:text-primary"
          >
            <svg
              class="h-4 w-4 transition-transform group-hover:-translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"></path></svg
            >
            <span class="font-bold tracking-wider uppercase">Back</span>
          </a>

          <div class="flex flex-wrap justify-center gap-1.5 sm:justify-end">
            {
              project.githubUrl && (
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-1.5 rounded-sm border border-border bg-card px-2 py-1 text-[10px] font-medium transition-colors hover:border-primary hover:text-primary"
                >
                  <svg
                    class="h-3.5 w-3.5"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                  </svg>
                </a>
              )
            }

            {
              project.projectUrl && (
                <a
                  href={project.projectUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-1.5 rounded-sm border border-border bg-card px-2 py-1 text-[10px] font-medium transition-colors hover:border-primary hover:text-primary"
                >
                  <svg
                    class="h-3.5 w-3.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    />
                  </svg>
                  <span>Live</span>
                </a>
              )
            }

            {
              hasVideo && project.videoUrl && (
                <a
                  href={project.videoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-1.5 rounded-sm border border-border bg-card px-2 py-1 text-[10px] font-medium transition-colors hover:border-primary hover:text-primary"
                >
                  <svg
                    class="h-3.5 w-3.5"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                  </svg>
                </a>
              )
            }
          </div>
        </div>

        <div class="text-center">
          <h1 class="text-xl font-black tracking-tight sm:text-2xl lg:text-3xl">
            {project.title}
          </h1>
          <div class="flex flex-wrap items-center justify-center gap-1.5">
            <span
              class="rounded-sm border border-primary/30 bg-primary/10 px-1.5 py-0.25 font-mono text-[9px] font-bold text-primary uppercase lg:text-[10px]"
              >{project.isPersonal ? "Personal" : "Production"}</span
            >
            <span
              class="rounded-sm border border-border bg-muted/60 px-1.5 py-0.25 font-mono text-[9px] font-bold text-foreground uppercase lg:text-[10px]"
              >{project.tag}</span
            >
            <span
              class="font-mono text-[9px] text-muted-foreground lg:text-[10px]"
              >{project.date}</span
            >
          </div>
          <p
            class="mx-auto mt-2 max-w-2xl font-sans text-[11px] leading-relaxed text-muted-foreground lg:text-sm"
          >
            {project.description}
          </p>
        </div>
      </div>

      <!-- MAIN MEDIA SECTION -->
      {
        hasVideo && (
          <div class="mb-6 w-full">
            <div class="relative aspect-video w-full overflow-hidden rounded-sm border border-border bg-black">
              <iframe
                src={videoEmbedUrl}
                title={`${project.title} Demonstration Video`}
                class="h-full w-full border-0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
              />
            </div>
          </div>
        )
      }

      {
        hasImages && (
          <div class="mb-6 w-full">
            <ImageCarousel images={images} hasVideo={hasVideo} client:load />
          </div>
        )
      }

      <!-- INFO SECTION -->
      <div class="w-full">
        <div class="grid gap-4 sm:gap-6">
          <div class="flex flex-col gap-2">
            <span
              class="font-mono text-[10px] font-bold tracking-widest text-muted-foreground uppercase"
              >Role</span
            >
            <p class="font-mono text-xs text-foreground lg:text-sm">
              {project.role}
            </p>
          </div>

          {
            project.stack && project.stack.length > 0 && (
              <div class="flex flex-col gap-2">
                <span class="font-mono text-[10px] font-bold tracking-widest text-muted-foreground uppercase">
                  Tech Stack
                </span>
                <div class="flex flex-wrap gap-1.5">
                  {project.stack.map((item: string) => (
                    <span class="rounded-sm border border-border bg-muted/40 px-2 py-0.5 font-mono text-[9px] font-medium text-foreground transition-colors hover:border-primary/50 lg:text-[10px]">
                      {item}
                    </span>
                  ))}
                </div>
              </div>
            )
          }

          {
            project.features && project.features.length > 0 && (
              <div class="flex flex-col gap-2">
                <span class="font-mono text-[10px] font-bold tracking-widest text-muted-foreground uppercase">
                  Features
                </span>
                <ul class="space-y-1">
                  {project.features.map((feat: string) => (
                    <li class="flex items-start gap-2 font-mono text-[10px] text-muted-foreground lg:text-sm">
                      <span class="mt-0.5 text-primary">✓</span>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            project.awards && project.awards.length > 0 && (
              <div class="flex flex-col gap-2">
                <span class="font-mono text-[10px] font-bold tracking-widest text-amber-600 uppercase dark:text-amber-400">
                  Awards
                </span>
                <div class="flex flex-wrap gap-2">
                  {project.awards.map((award: any) => (
                    <div class="flex items-center gap-1.5 rounded-sm border border-amber-500/30 bg-amber-500/10 px-2 py-1 font-mono text-[9px] text-amber-700 lg:text-[10px] dark:text-amber-300">
                      <span>🏆</span>
                      <span class="font-bold">
                        {award.title.replace(/_/g, " ")}
                      </span>
                      <span class="opacity-60">({award.organization})</span>
                    </div>
                  ))}
                </div>
              </div>
            )
          }
        </div>
      </div>

      <!-- BOTTOM NAVIGATION -->
      <div class="mt-8 w-full pt-8">
        <div class="mb-6 w-full border-t border-border"></div>
        <div class="flex items-center justify-between">
          <div></div>
          <div class="flex items-center gap-2">
            {
              prevProject && (
                <a
                  href={`/projects/${prevProject.id}`}
                  class="group flex items-center gap-1 border border-border bg-card px-2 py-0.5 text-[10px] font-medium transition-colors hover:border-primary hover:text-primary"
                >
                  <svg
                    class="h-3 w-3"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 19l-7-7 7-7"
                    />
                  </svg>
                  <span>{prevProject.title}</span>
                </a>
              )
            }
            {
              nextProject && (
                <a
                  href={`/projects/${nextProject.id}`}
                  class="group flex items-center gap-1 border border-border bg-card px-2 py-0.5 text-[10px] font-medium transition-colors hover:border-primary hover:text-primary"
                >
                  <span>{nextProject.title}</span>
                  <svg
                    class="h-3 w-3"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </a>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.addEventListener("astro:page-load", () => {
      // Force rehydration of React components if needed
      const event = new CustomEvent("astro:hydration-load")
      document.dispatchEvent(event)
    })
  </script>
</MainLayout>
