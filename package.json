{
  "name": "astro-app",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "overrides": {
    "vite": "^7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:cloudflare": "ASTRO_ADAPTER=cloudflare astro build",
    "preview": "astro preview",
    "preview:cloudflare": "ASTRO_ADAPTER=cloudflare astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,astro}\"",
    "typecheck": "astro check",
    "deploy:cloudflare": "wrangler deploy",
    "deploy:cloudflare:dev": "wrangler deploy --env development",
    "tail:cloudflare": "wrangler tail --format json"
  },
  "pnpm": {
    "overrides": {
      "vite": "^7"
    }
  },
  "dependencies": {
    "@astrojs/node": "^11.0.2",
    "@astrojs/react": "^5",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@tailwindcss/vite": "^4",
    "@thesvg/react": "^3.3.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "astro": "^6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "thesvg": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9",
    "@eslint/js": "^10",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.1.1",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8"
  }
}
