---
import MainLayout from "@/layouts/main.astro"
import { getProjects, getD1 } from "@/db/db"

// Get D1 instance from Cloudflare runtime locals
const d1 = getD1()

// Get all unique tags for dropdown
const projects = await getProjects(d1)
const tagOptions = [...new Set(projects.map((p) => p.tag).filter(Boolean))]
---

<MainLayout>
  <section
    class="flex h-full w-full flex-col items-center justify-start px-4 py-12"
  >
    <div class="w-full max-w-2xl space-y-6">
      <!-- Header -->
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold tracking-tight">
            <span class="font-mono text-[hsl(var(--chart-1))]">➕</span> New Project
          </h1>
          <p class="mt-1 text-sm text-muted-foreground">
            Add a new project to your portfolio
          </p>
        </div>
        <a
          href="/admin/projects"
          class="rounded-sm border border-border bg-secondary/50 px-3 py-1.5 font-mono text-xs font-bold tracking-wider uppercase transition-colors hover:bg-secondary/80"
        >
          Back
        </a>
      </div>

      <!-- Form -->
      <form
        id="create-project-form"
        class="space-y-6 rounded-sm border border-border bg-card p-6 shadow-sm"
      >
        <!-- Title -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Title *
          </label>
          <input
            type="text"
            id="project-title"
            name="title"
            placeholder="Project name..."
            required
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
        </div>

        <!-- Tech Stack -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Tech Stack
          </label>
          <input
            type="text"
            id="project-tech"
            name="tech"
            placeholder="e.g., REACT / NEXT.JS / TAILWIND"
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
        </div>

        <!-- Role -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Role
          </label>
          <input
            type="text"
            id="project-role"
            name="role"
            placeholder="e.g., Lead Developer, Designer, etc."
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
        </div>

        <!-- Date -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Date
          </label>
          <input
            type="text"
            id="project-date"
            name="date"
            placeholder="e.g., JAN_2025"
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
        </div>

        <!-- Released At -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Release Date (YYYY-MM-DD)
          </label>
          <input
            type="date"
            id="project-releasedAt"
            name="releasedAt"
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
        </div>

        <!-- Tag -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Tag
          </label>
          <select
            id="project-tag"
            name="tag"
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          >
            <option value="">Select a tag...</option>
            {
              tagOptions.map((tag) => (
                <option key={tag} value={tag}>
                  {tag}
                </option>
              ))
            }
            <option value="MOBILE">MOBILE</option>
            <option value="WEB">WEB</option>
            <option value="GAME">GAME</option>
          </select>
        </div>

        <!-- Description -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Description
          </label>
          <textarea
            id="project-description"
            name="description"
            rows={4}
            placeholder="Project description..."
            class="w-full resize-none rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          ></textarea>
        </div>

        <!-- Cover Image Upload -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Cover Image
          </label>
          <div class="flex gap-2">
            <input
              type="file"
              id="project-cover-upload"
              accept="image/*"
              class="flex-1 rounded-sm border border-border bg-secondary/40 px-3 py-2 text-sm file:mr-2 file:rounded-sm file:border-0 file:bg-primary/10 file:px-3 file:py-1 file:font-mono file:text-sm file:text-primary"
            />
            <button
              type="button"
              onclick="uploadFile('project-cover-upload', 'project-cover', 'image', 'projects')"
              class="rounded-sm border border-border bg-secondary/50 px-3 py-2 font-mono text-xs tracking-wider uppercase transition-colors hover:bg-secondary/80"
            >
              Upload
            </button>
          </div>
          <input
            type="text"
            id="project-cover"
            name="cover"
            placeholder="https://example.com/image.jpg"
            class="mt-2 w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
          <div id="project-cover-upload-preview" class="mt-2"></div>
        </div>

        <!-- Images Upload -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Gallery Images
          </label>
          <div class="flex gap-2">
            <input
              type="file"
              id="project-imgs-upload"
              accept="image/*"
              multiple
              class="flex-1 rounded-sm border border-border bg-secondary/40 px-3 py-2 text-sm file:mr-2 file:rounded-sm file:border-0 file:bg-primary/10 file:px-3 file:py-1 file:font-mono file:text-sm file:text-primary"
            />
            <button
              type="button"
              onclick="uploadMultipleFiles('project-imgs-upload', 'project-imgs', 'image', 'projects')"
              class="rounded-sm border border-border bg-secondary/50 px-3 py-2 font-mono text-xs tracking-wider uppercase transition-colors hover:bg-secondary/80"
            >
              Upload
            </button>
          </div>
          <input
            type="text"
            id="project-imgs"
            name="imgs"
            placeholder="https://example.com/img1.jpg, https://example.com/img2.jpg"
            class="mt-2 w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
          <p class="font-mono text-[10px] text-muted-foreground/60">
            Enter image URLs separated by commas, or upload multiple files
          </p>
          <div
            id="project-imgs-upload-preview"
            class="mt-2 grid grid-cols-3 gap-2"
          >
          </div>
        </div>

        <!-- GitHub URL -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            GitHub URL
          </label>
          <input
            type="url"
            id="project-githubUrl"
            name="githubUrl"
            placeholder="https://github.com/username/repo"
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
        </div>

        <!-- Project URL -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Live URL
          </label>
          <input
            type="url"
            id="project-projectUrl"
            name="projectUrl"
            placeholder="https://project-demo.com"
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
        </div>

        <!-- Features (comma-separated) -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Features (comma-separated)
          </label>
          <input
            type="text"
            id="project-features"
            name="features"
            placeholder="Feature 1, Feature 2, Feature 3"
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
        </div>

        <!-- Stack (comma-separated) -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Stack (comma-separated)
          </label>
          <input
            type="text"
            id="project-stack"
            name="stack"
            placeholder="React, Next.js, Tailwind"
            class="w-full rounded-sm border border-border bg-secondary/40 px-3 py-2.5 text-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          />
        </div>

        <!-- Awards (JSON) -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Awards (JSON format)
          </label>
          <textarea
            id="project-awards"
            name="awards"
            rows={3}
            placeholder='[{"title": "Award Name", "organization": "Org"}]'
            class="w-full resize-none rounded-sm border border-border bg-secondary/40 px-3 py-2.5 font-mono text-sm text-[10px] transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          ></textarea>
        </div>

        <!-- Metrics (JSON) -->
        <div class="space-y-1">
          <label
            class="font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
          >
            Metrics (JSON format)
          </label>
          <textarea
            id="project-metrics"
            name="metrics"
            rows={3}
            placeholder='[{"label": "METRIC", "value": 100}]'
            class="w-full resize-none rounded-sm border border-border bg-secondary/40 px-3 py-2.5 font-mono text-sm text-[10px] transition-all focus:border-primary focus:ring-1 focus:ring-primary/20 focus:outline-none"
          ></textarea>
        </div>

        <!-- Featured & Personal -->
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-1">
            <label
              class="flex items-center gap-2 font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
            >
              <input
                type="checkbox"
                id="project-isFeatured"
                name="isFeatured"
                value="1"
                class="h-3 w-3"
              />
              Featured
            </label>
          </div>
          <div class="space-y-1">
            <label
              class="flex items-center gap-2 font-mono text-[10px] tracking-wider text-muted-foreground/80 uppercase"
            >
              <input
                type="checkbox"
                id="project-isPersonal"
                name="isPersonal"
                value="1"
                class="h-3 w-3"
              />
              Personal
            </label>
          </div>
        </div>

        <!-- Submit -->
        <div class="flex gap-2">
          <button
            type="submit"
            class="flex-1 rounded-sm bg-[hsl(var(--chart-1))] py-2.5 font-mono text-sm font-bold tracking-wider text-white uppercase transition-all hover:bg-[hsl(var(--chart-1))]/90"
          >
            Create Project
          </button>
          <button
            type="button"
            onclick="window.location.href='/admin/projects'"
            class="rounded-sm border border-border bg-secondary/50 px-4 py-2.5 font-mono text-sm font-bold tracking-wider uppercase transition-colors hover:bg-secondary/80"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </section>

  <script>
    // Check auth on page load
    document.addEventListener("DOMContentLoaded", () => {
      const isLoggedIn =
        sessionStorage.getItem("admin_logged_in") ||
        localStorage.getItem("admin_token")
      if (!isLoggedIn) {
        const adminSeed = import.meta.env.ADMIN_SEED
        window.location.href = `/secret/${adminSeed}/admin`
      }

      // Form submission
      const form = document.getElementById("create-project-form")
      form?.addEventListener("submit", async (e) => {
        e.preventDefault()

        // Collect form data
        const formData = {
          title: (document.getElementById("project-title") as HTMLInputElement)
            .value,
          tech: (document.getElementById("project-tech") as HTMLInputElement)
            .value,
          role: (document.getElementById("project-role") as HTMLInputElement)
            .value,
          date: (document.getElementById("project-date") as HTMLInputElement)
            .value,
          releasedAt: (
            document.getElementById("project-releasedAt") as HTMLInputElement
          ).value,
          tag: (document.getElementById("project-tag") as HTMLInputElement)
            .value,
          description: (
            document.getElementById(
              "project-description"
            ) as HTMLTextAreaElement
          ).value,
          cover: (document.getElementById("project-cover") as HTMLInputElement)
            .value,
          imgs: (document.getElementById("project-imgs") as HTMLInputElement)
            .value,
          githubUrl: (
            document.getElementById("project-githubUrl") as HTMLInputElement
          ).value,
          projectUrl: (
            document.getElementById("project-projectUrl") as HTMLInputElement
          ).value,
          features: (
            document.getElementById("project-features") as HTMLInputElement
          ).value,
          stack: (document.getElementById("project-stack") as HTMLInputElement)
            .value,
          awards: (
            document.getElementById("project-awards") as HTMLTextAreaElement
          ).value,
          metrics: (
            document.getElementById("project-metrics") as HTMLTextAreaElement
          ).value,
          isFeatured: (
            document.getElementById("project-isFeatured") as HTMLInputElement
          ).checked
            ? 1
            : 0,
          isPersonal: (
            document.getElementById("project-isPersonal") as HTMLInputElement
          ).checked
            ? 1
            : 0,
        }

        try {
          const response = await fetch("/api/admin/projects", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${localStorage.getItem("admin_token")}`,
            },
            body: JSON.stringify(formData),
          })

          if (response.ok) {
            window.location.href = "/admin/projects"
          } else {
            const error = await response.json()
            alert(error.error || "Failed to create project")
          }
        } catch (err) {
          alert("Error creating project: " + err)
        }
      })
    })

    // File upload function
    async function uploadFile(
      inputId: string,
      urlInputId: string,
      fileType: string,
      dir: string
    ) {
      const fileInput = document.getElementById(inputId) as HTMLInputElement
      const urlInput = document.getElementById(urlInputId) as HTMLInputElement
      const previewContainer = document.getElementById(`${inputId}-preview`)

      if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
        alert("Please select a file first")
        return
      }

      const file = fileInput.files[0]
      const token = localStorage.getItem("admin_token")

      try {
        const formData = new FormData()
        formData.append("file", file)
        formData.append("type", fileType)
        formData.append("dir", dir)

        const response = await fetch("/api/upload", {
          method: "POST",
          headers: {
            Authorization: `Bearer ${token}`,
          },
          body: formData,
        })

        if (response.ok) {
          const result = await response.json()
          urlInput.value = result.url

          // Show preview for images
          if (fileType === "image" && previewContainer) {
            previewContainer.innerHTML = `
              <div class="relative">
                <img src="${result.url}" class="h-32 w-auto rounded-sm object-cover" />
                <button
                  onclick="clearUpload('${inputId}', '${urlInputId}', '${inputId}-preview')"
                  class="absolute top-1 right-1 h-5 w-5 rounded-full bg-red-500/20 flex items-center justify-center text-red-500 hover:bg-red-500/40"
                >
                  ✕
                </button>
              </div>
            `
          }

          alert("File uploaded successfully!")
        } else {
          const error = await response.json()
          alert(error.error || "Failed to upload file")
        }
      } catch (err) {
        alert("Error uploading file: " + err)
      }
    }

    // Multiple files upload
    async function uploadMultipleFiles(
      inputId: string,
      urlInputId: string,
      fileType: string,
      dir: string
    ) {
      const fileInput = document.getElementById(inputId) as HTMLInputElement
      const urlInput = document.getElementById(urlInputId) as HTMLInputElement
      const previewContainer = document.getElementById(`${inputId}-preview`)

      if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
        alert("Please select at least one file")
        return
      }

      const token = localStorage.getItem("admin_token")
      const uploadedUrls: string[] = []

      try {
        for (const file of fileInput.files) {
          const formData = new FormData()
          formData.append("file", file)
          formData.append("type", fileType)
          formData.append("dir", dir)

          const response = await fetch("/api/upload", {
            method: "POST",
            headers: {
              Authorization: `Bearer ${token}`,
            },
            body: formData,
          })

          if (response.ok) {
            const result = await response.json()
            uploadedUrls.push(result.url)

            // Show preview for images
            if (fileType === "image" && previewContainer) {
              previewContainer.innerHTML += `
                <div class="relative">
                  <img src="${result.url}" class="h-20 w-full rounded-sm object-cover" />
                  <button
                    onclick="removeImageFromGallery('${result.url}', '${inputId}', '${urlInputId}', '${inputId}-preview')"
                    class="absolute top-1 right-1 h-4 w-4 rounded-full bg-red-500/20 flex items-center justify-center text-red-500 hover:bg-red-500/40 text-[8px]"
                  >
                    ✕
                  </button>
                </div>
              `
            }
          } else {
            const error = await response.json()
            alert(error.error || "Failed to upload one or more files")
            return
          }
        }

        // Set all URLs in the input
        if (urlInput) {
          urlInput.value = uploadedUrls.join(", ")
        }

        alert(`${uploadedUrls.length} file(s) uploaded successfully!`)
      } catch (err) {
        alert("Error uploading files: " + err)
      }
    }

    function clearUpload(
      inputId: string,
      urlInputId: string,
      previewId: string
    ) {
      const fileInput = document.getElementById(inputId) as HTMLInputElement
      const urlInput = document.getElementById(urlInputId) as HTMLInputElement
      const previewContainer = document.getElementById(previewId)

      if (fileInput) fileInput.value = ""
      if (urlInput) urlInput.value = ""
      if (previewContainer) previewContainer.innerHTML = ""
    }

    function removeImageFromGallery(
      url: string,
      inputId: string,
      urlInputId: string,
      previewId: string
    ) {
      const urlInput = document.getElementById(urlInputId) as HTMLInputElement
      const previewContainer = document.getElementById(previewId)

      if (urlInput) {
        const urls = urlInput.value
          .split(",")
          .map((u) => u.trim())
          .filter((u) => u !== url)
        urlInput.value = urls.join(", ")
      }

      // Remove from preview - this is a simple approach
      if (previewContainer) {
        previewContainer.innerHTML = ""
        // In a real implementation, you'd find and remove just the specific image
        // For now, we'll just clear and let user re-upload if needed
      }
    }
  </script>
</MainLayout>
